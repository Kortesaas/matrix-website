---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer, { type Peeker } from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import Play from '../components/Play.astro';
import type { Accent } from '../data/site';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** The page's single accent colour. */
  accent: Accent;
  /** Key of the active nav item. */
  current?: string;
  peeker?: Peeker;
  peekerLeft?: string;
  /** Hide from search engines (404 page). */
  noindex?: boolean;
}

const { title, description, accent, current, peeker, peekerLeft, noindex = false } = Astro.props;

const fullTitle = Astro.url.pathname === '/' ? `${site.name} – Jugendzentrum Königsbrunn` : `${title} – ${site.name} Königsbrunn`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#907BE0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/boogaloo-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/graphics/cursors/hand@2x.png" as="image" />
    <link rel="preload" href="/graphics/cursors/hand-flat@2x.png" as="image" />
    <script is:inline>
      // Coming from another page with the MatriX hand: hide the system cursor
      // from the first frame on, Cursor.astro then draws the hand in place.
      try {
        if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
          const last = JSON.parse(sessionStorage.getItem('mx-cursor') || 'null');
          if (last && Date.now() - last.t < 10000) document.documentElement.classList.add('mx-has-cursor');
        }
      } catch {}
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body data-accent={accent}>
    <a class="mx-skip" href="#inhalt">Zum Inhalt springen</a>
    <Header current={current} />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <Footer peeker={peeker} peekerLeft={peekerLeft} />
    <Cursor />
    <Play />
  </body>
</html>

<style>
  .mx-skip {
    position: absolute;
    z-index: 100;
    top: var(--space-2);
    left: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--white);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .mx-skip:focus { transform: none; }
  main:focus { outline: none; }
</style>
