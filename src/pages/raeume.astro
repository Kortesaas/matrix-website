---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureRow from '../components/FeatureRow.astro';
import Squiggles from '../components/Squiggles.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { rooms } from '../data/rooms';
---

<BaseLayout
  title="Räume"
  description="Chill-Lounge, X-Bar, Werkstatt, Saal, Tonstudio und mehr: Sieben Räume, ein Haus – die Räume der MatriX Königsbrunn."
  accent="purple"
  current="raeume"
  peeker="dino-wave"
>
  <PageHero deco="raeume-hero-deco" sticker="sun-omg" stickerSide="right">Räume</PageHero>

  <section class="mx-section">
    <Squiggles
      items={[
        { side: 'left', inset: '-60px', top: '40%' },
        { side: 'right', inset: '-40px', top: '70%', rotate: 160 },
      ]}
    />
    <div class="mx-container mx-layer">
      <SectionHeading
        title="Komm rein – in die heiligen Hallen."
        size="h1"
        lead="Sieben Räume, ein Haus: Hier ist Platz zum Chillen, Bauen, Proben und Feiern."
      />
      {
        rooms.map((room, i) => (
          <FeatureRow
            id={room.slug}
            kicker={`Raum ${String(i + 1).padStart(2, '0')}`}
            title={room.title}
            text={room.text}
            photos={room.photos}
            alt={room.alt}
            accent={room.accent}
            flip={i % 2 === 1}
            offset={i % 2 === 1 ? 'bl' : 'br'}
          />
        ))
      }
    </div>
  </section>

  <CtaBlock
    title="Und das war noch lange nicht alles!"
    lead="Abseits der großen Räume gibt’s in der MatriX noch viel mehr zu entdecken. Schau dich doch einfach mal um."
    label="Zur Roomtour"
    href="/#roomtour"
  />
</BaseLayout>
