---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCalendar from '../components/EventCalendar.astro';
import FlyerWall from '../components/FlyerWall.astro';
import SocialLinks from '../components/SocialLinks.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { todayInKoenigsbrunn } from '../data/events';
---

<BaseLayout
  title="Aktuelles"
  description="Konzerte, Turniere, Partys und feste Termine jede Woche: Das ist gerade los in der MatriX Königsbrunn."
  accent="green"
  current="aktuelles"
  peeker="daisy-face"
  peekerLeft="18%"
>
  <PageHero deco="aktuelles-hero-deco" sticker="flower-face" stickerSide="right">Aktuelles</PageHero>

  <FlyerWall />

  <section class="mx-section" id="kalender">
    <div class="mx-container aktuelles-events">
      <SectionHeading
        title="MatriX Kalender"
        lead="Tipp auf einen Tag, um zu sehen, was dort läuft. Mit den Pfeilen blätterst du durch die Monate."
      />
      <EventCalendar today={todayInKoenigsbrunn()} />
    </div>
  </section>

  <section class="mx-section">
    <div class="mx-container">
      <SectionHeading title="Hier folgen, um nichts zu verpassen:" />
      <SocialLinks />
    </div>
  </section>

  <CtaBlock
    title="Du hast eine Idee für ein Event?"
    lead="Konzert, Turnier oder Workshop? Erzähl uns davon. Vieles, was hier läuft, haben Jugendliche selbst auf die Beine gestellt."
    label="Mitmachen!"
    href="/mitmachen/"
  />
</BaseLayout>

<style>
  .aktuelles-events { max-width: 1160px; }
</style>
