---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Graphic from '../components/Graphic.astro';
import Photo from '../components/Photo.astro';
import ContactForm from '../components/ContactForm.astro';
import FeatureRow from '../components/FeatureRow.astro';
import { fsjPage } from '../data/fsj';
import groupOutdoors from '../assets/youth/group-outdoors.png';
import { site } from '../data/site';
import screenPhoto from '../assets/photos/p11.jpg';

const videoUrl = 'https://www.youtube.com/watch?v=dQw4w9WgXcQ';
---

<BaseLayout
  title="Mitmachen"
  description="Die MatriX lebt von Ideen und Engagement. Komm vorbei oder schreib uns. Hier findest du Telefon, E-Mail und Social Media der MatriX Königsbrunn."
  accent="blue"
  current="mitmachen"
  peeker="dino-wave"
  peekerLeft="16%"
>
  <PageHero deco="rainbow-clouds">Mitmachen</PageHero>

  <section class="mx-section">
    <div class="mx-container">
      <SectionHeading
        size="h1"
        lead="Die MatriX lebt von Ideen und Engagement! Egal ob du eine Veranstaltung organisieren willst, kreative Ideen hast oder einfach neue Leute kennenlernen möchtest, hier bist du richtig!"
      >
        <Fragment slot="title">Komm vorbei oder schreib uns!</Fragment>
      </SectionHeading>

      <div class="why">
        <div class="why__text">
          <h2 class="mx-h1">Warum es sich lohnt, mitzumachen?</h2>
          <p class="mx-body">
            Du lernst Leute kennen, probierst Neues aus und stellst eigene Projekte auf die Beine, vom Konzert bis zum Upcycling-Workshop. Wir helfen dir dabei, und du bestimmst mit, was in der MatriX passiert.
          </p>
        </div>
        <div class="why__media">
          <a class="why__computer" href={videoUrl} target="_blank" rel="noopener" aria-label="Musikvideo auf YouTube ansehen">
            <Graphic name="retro-computer" class="why__art" play={false} />
            <div class="why__screen">
              <div class="why__picture">
                <Photo src={screenPhoto} alt="Die MatriX-Lounge mit Sofas und Tischtennisplatte" sizes="(max-width: 860px) 34vw, 220px" widths={[320, 480]} />
              </div>
              <span class="why__noise" aria-hidden="true"><canvas data-tv-noise></canvas></span>
              <span class="why__play" aria-hidden="true"></span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-section" id="fsj">
    <div class="mx-container">
      <FeatureRow
        kicker="Freiwilliges Soziales Jahr"
        title={fsjPage.teaser.title}
        text={fsjPage.teaser.text}
        photos={[groupOutdoors]}
        alt="Jugendliche der MatriX gemeinsam im Außenbereich"
        offset="bl"
        facts={fsjPage.facts.map((fact) => fact.value)}
        link={{ href: fsjPage.href, label: fsjPage.teaser.label }}
      />
    </div>
  </section>

  <section class="mx-section" id="kontakt">
    <div class="mx-container">
      <SectionHeading title="Schreib uns!" lead="Fragen, Ideen, Lob oder Kritik: Schick uns eine Nachricht, wir lesen alles und melden uns bei dir." />
      <div class="contact">
        <ContactForm />
        <aside class="contact__direct" aria-labelledby="contact-direct-title">
          <h3 class="mx-h3" id="contact-direct-title">Lieber direkt?</h3>
          <dl class="contact__list">
            <div>
              <dt>E-Mail</dt>
              <dd><a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div>
              <dt>Telefon</dt>
              <dd><a href={site.phone.href}>{site.phone.display}</a></dd>
            </div>
            <div>
              <dt>Adresse</dt>
              <dd>
                <address>
                  {site.legalName}<br />
                  {site.address.street}<br />
                  {site.address.zip} {site.address.city}
                </address>
              </dd>
            </div>
          </dl>
          <h4 class="contact__social-title">Hier findest du uns überall</h4>
          <SocialLinks variant="list" />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/tv-static';
</script>

<style>
  /* ---------- Why join ---------- */
  .why {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: center;
    margin-top: var(--space-10);
  }
  .why__text { grid-column: 1 / span 5; }
  .why__text .mx-body { margin-top: var(--space-5); max-width: var(--measure-body); }
  .why__media { grid-column: 7 / span 6; }

  .why__computer { position: relative; display: block; }
  .why__computer :global(.why__art) { width: 100%; height: auto; }

  /* The still sits on the monitor's screen (measured on the 635×509 art). */
  .why__screen {
    position: absolute;
    left: 22.8%;
    top: 14.6%;
    width: 35.8%;
    height: 38%;
    overflow: hidden;
    border-radius: 4px;
    background: var(--ink);
    isolation: isolate;
  }
  .why__picture {
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .why__screen :global(picture) { height: 100%; }
  .why__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .why__noise {
    position: absolute;
    inset: 0;
    background: #777;
    opacity: 1;
  }
  .why__noise canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; }
  .why__noise::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(transparent 0 2px, #131a2214 2px 3px);
  }
  /* A CRT starts as a bright dot, stretches into a line, then opens out. */
  .why__screen::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--white);
    box-shadow: 0 0 18px var(--blue-50);
    opacity: 0;
  }
  .why__computer:is(:hover, :focus-visible) .why__noise { opacity: 0; }
  .why__computer:is(:hover, :focus-visible) .why__picture { opacity: 1; }
  .why__computer:is(:hover, :focus-visible) .why__play { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .why__computer:is(:hover, :focus-visible) .why__screen::after { animation: tv-power-on .8s ease-out both; }
    .why__computer:is(:hover, :focus-visible) .why__picture { animation: tv-picture-on .8s ease-out both; }
    .why__computer:is(:hover, :focus-visible) .why__play { transition-delay: .8s; }
  }
  @keyframes tv-power-on {
    0% { opacity: 0; transform: scale(.025, .025); border-radius: 50%; }
    12% { opacity: 1; transform: scale(.025, .025); border-radius: 50%; }
    38% { opacity: 1; transform: scale(1, .025); border-radius: 0; }
    55% { opacity: 1; transform: scale(1, .04); }
    80% { opacity: .65; transform: scale(1, 1); }
    100% { opacity: 0; transform: scale(1, 1); }
  }
  @keyframes tv-picture-on {
    0%, 42% { opacity: 0; transform: scaleY(.025); }
    55% { opacity: 1; transform: scaleY(.04); filter: brightness(1.6) saturate(.3); }
    85% { opacity: 1; transform: scaleY(1); filter: brightness(1.1) saturate(1.1); }
    100% { opacity: 1; transform: scaleY(1); filter: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .why__computer .why__play { transition: none; }
  }
  @media (hover: none) {
    .why__noise { display: none; }
    .why__computer .why__picture,
    .why__computer:is(:hover, :focus-visible) .why__picture { opacity: 1; animation: none; }
    .why__screen::after { display: none; }
    .why__computer .why__play { opacity: 1; }
  }

  .why__play {
    opacity: 0;
    transition: opacity .15s;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .why__play::before {
    content: "";
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: var(--shadow-press);
  }
  .why__play::after {
    content: "";
    position: absolute;
    border-style: solid;
    border-width: 11px 0 11px 18px;
    border-color: transparent transparent transparent var(--accent-strong);
    transform: translateX(3px);
  }

  /* ---------- Contact ---------- */
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-7);
    align-items: start;
    margin-top: var(--space-8);
  }
  .contact__direct {
    padding: var(--space-6);
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    background: var(--accent-tint);
    box-shadow: var(--shadow-press);
  }
  .contact__direct h3 { margin: 0 0 var(--space-5); }
  .contact__list { display: grid; gap: var(--space-4); margin: 0; }
  .contact__list dt { font-size: var(--fs-small); font-weight: 600; color: var(--ink-muted); }
  .contact__list dd { margin: 2px 0 0; }
  .contact__list address { font-style: normal; }
  .contact__direct a { color: var(--accent-strong); font-weight: 600; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .contact__direct .contact__email { font: var(--fs-h4)/1.1 var(--font-display); overflow-wrap: anywhere; }
  .contact__social-title {
    margin: var(--space-6) 0 var(--space-3);
    padding-top: var(--space-5);
    border-top: 2px dashed color-mix(in srgb, var(--ink) 30%, transparent);
    font: var(--fs-h4)/1.1 var(--font-display);
  }
  .contact__direct :global(.mx-social a) { color: var(--accent-strong); }

  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; gap: var(--space-8); }
    .why { display: flex; flex-direction: column-reverse; gap: var(--space-7); margin-top: var(--space-9); }
  }
</style>
