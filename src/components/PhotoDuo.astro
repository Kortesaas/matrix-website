---
/** Two overlapping framed photos: the second sits lower right by 38%. */
import type { ImageMetadata } from 'astro';
import PhotoFrame from './PhotoFrame.astro';

interface Props {
  photos: [ImageMetadata, ImageMetadata];
  alt: string;
  /** False when a containing link already provides the action. */
  interactive?: boolean;
}

const { photos, alt, interactive = true } = Astro.props;
---

<div class="mx-photo-duo">
  <PhotoFrame src={photos[0]} alt={alt} ratio="4/3" offset="tl" sizes="(max-width: 860px) 70vw, 400px" class="mx-photo-duo__a" {interactive} />
  <PhotoFrame src={photos[1]} alt={alt} ratio="1" offset="br" sizes="(max-width: 860px) 60vw, 350px" class="mx-photo-duo__b" {interactive} />
</div>

<style>
  .mx-photo-duo {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }
  .mx-photo-duo :global(.mx-photo-duo__a) { grid-column: 1 / span 8; grid-row: 1; }
  .mx-photo-duo :global(.mx-photo-duo__b) { grid-column: 6 / span 7; grid-row: 1; margin-top: 38%; }
</style>
