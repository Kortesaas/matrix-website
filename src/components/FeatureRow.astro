---
/**
 * Alternating text + media row (rooms, workshop areas). Text in columns 1–5,
 * media in 7–12; `flip` mirrors it. Under 860px rows stack with media first.
 */
import type { ImageMetadata } from 'astro';
import PhotoFrame, { type Offset } from './PhotoFrame.astro';
import PhotoDuo from './PhotoDuo.astro';
import type { Accent } from '../data/site';
import Button from './Button.astro';

interface Props {
  id?: string;
  kicker?: string;
  title: string;
  text: string;
  /** Optional when the `media` slot supplies something else. */
  photos?: [ImageMetadata] | [ImageMetadata, ImageMetadata];
  alt?: string;
  flip?: boolean;
  /** Offset direction for a single photo. */
  offset?: Offset;
  /** Rooms may each take their own accent. */
  accent?: Accent;
  facts?: string[];
  link?: { href: string; label: string };
}

const { id, kicker, title, text, photos = [], alt = '', flip = false, offset = 'br', accent, facts, link } = Astro.props;
---

<article class:list={['mx-feature', flip && 'mx-feature--flip']} id={id} data-accent={accent}>
  <div class="mx-feature__text">
    {kicker && <span class="mx-feature__kicker">{kicker}</span>}
    <h3 class="mx-h3">{link ? <a href={link.href} class="mx-feature__title-link">{title}</a> : title}</h3>
    {text.split('\n\n').map((paragraph) => <p class="mx-body">{paragraph}</p>)}
    {link && <div class="mx-feature__link"><Button href={link.href} variant="outline" size="sm">{link.label} ↗</Button></div>}
    {
      facts && facts.length > 0 && (
        <ul class="mx-feature__facts">
          {facts.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="mx-feature__media">
    <slot name="media">
    {
      // With a link, the photos lead to the page too instead of the photo viewer.
      link && photos.length ? (
        <a href={link.href} class="mx-feature__media-link" tabindex="-1" aria-hidden="true">
          {photos.length === 2 ? <PhotoDuo photos={photos} alt={alt} interactive={false} /> : <PhotoFrame src={photos[0]} alt={alt} ratio="4/3" offset={offset} sizes="(max-width: 860px) 92vw, 620px" interactive={false} />}
        </a>
      ) : photos.length === 2 ? (
        <PhotoDuo photos={photos} alt={alt} />
      ) : photos.length === 1 ? (
        <PhotoFrame src={photos[0]} alt={alt} ratio="4/3" offset={offset} sizes="(max-width: 860px) 92vw, 620px" />
      ) : null
    }
    </slot>
  </div>
</article>

<style>
  .mx-feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: center;
    scroll-margin-top: var(--space-11);
  }
  .mx-feature + .mx-feature { margin-top: var(--space-10); }

  .mx-feature__text { grid-column: 1 / span 5; }
  .mx-feature__media { grid-column: 7 / span 6; }
  .mx-feature--flip .mx-feature__text { grid-column: 8 / span 5; grid-row: 1; }
  .mx-feature--flip .mx-feature__media { grid-column: 1 / span 6; grid-row: 1; }

  .mx-feature__kicker {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1;
    color: var(--ink-muted);
  }

  .mx-feature .mx-h3 { margin-bottom: var(--space-4); }
  .mx-feature .mx-body { max-width: var(--measure-body); }
  .mx-feature .mx-body + .mx-body { margin-top: var(--space-4); }
  .mx-feature__link { margin-top: var(--space-5); }
  .mx-feature__title-link { color: inherit; text-decoration: none; }
  .mx-feature__title-link:hover { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .mx-feature__media-link { display: block; transition: transform var(--motion-slow) ease; }
  .mx-feature__media-link:hover { transform: translateY(-4px) rotate(-.5deg); }

  .mx-feature__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .mx-feature__facts li {
    padding: 6px 12px 5px;
    border-radius: var(--radius-pill);
    background: var(--white);
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .mx-feature,
    .mx-feature--flip {
      display: flex;
      flex-direction: column-reverse;
      gap: var(--space-7);
      align-items: stretch;
    }
    .mx-feature + .mx-feature { margin-top: var(--space-9); }
  }
</style>
