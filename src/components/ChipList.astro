---
/** Tappable offer links ("Bei uns ist für alle was dabei."). One chip may be featured. */
interface Chip {
  label: string;
  href: string;
  hot?: boolean;
}

interface Props {
  chips: Chip[];
  label?: string;
}

const { chips, label } = Astro.props;
---

<ul class="mx-chips" aria-label={label}>
  {
    chips.map((chip) => (
      <li>
        <a class:list={['mx-chip', chip.hot && 'mx-chip--hot']} href={chip.href}>
          {chip.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .mx-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mx-chip {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 10px 18px 8px;
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 23px;
    line-height: 1;
    text-decoration: none;
    box-shadow: inset 0 0 0 2px var(--line);
    transition:
      box-shadow var(--motion-fast) var(--ease-matrix),
      transform var(--motion-fast) var(--ease-matrix),
      color var(--motion-fast) var(--ease-matrix);
  }

  .mx-chip:hover {
    box-shadow: inset 0 0 0 3px var(--chip, var(--accent-strong));
    color: var(--chip, var(--accent-strong));
    transform: translateY(-2px);
  }

  .mx-chip--hot {
    box-shadow: inset 0 0 0 3px var(--pink-600);
    color: var(--pink-600);
  }

  @media (max-width: 600px) {
    .mx-chip { font-size: 21px; min-height: 44px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-chip { transition: none; }
  }
</style>
