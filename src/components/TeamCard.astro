---
/**
 * A team member: square portrait on the offset block, name, role.
 * Without a portrait a placeholder tile (the X on the accent ground) holds
 * the slot. The open-position variant shows a character on a yellow frame.
 */
import PhotoFrame from './PhotoFrame.astro';
import Graphic from './Graphic.astro';
import Icon from './Icon.astro';
import type { OpenPosition, TeamMember } from '../data/team';

interface Props {
  member: TeamMember | OpenPosition;
}

const { member } = Astro.props;
const isOpen = 'open' in member;
---

{
  isOpen ? (
    <a class="mx-person mx-person--open" href={member.href}>
      <div class="mx-person__tile mx-person__tile--open">
        <div class="mx-person__face">
          <Graphic name="egg-hi" class="mx-person__sticker" play={false} />
        </div>
      </div>
      <div class="mx-person__name">{member.title}</div>
      <div class="mx-person__role">{member.text}</div>
    </a>
  ) : (
    <article class="mx-person" tabindex={member.portrait ? undefined : 0} aria-label={`${member.name}, ${member.role}`}>
      {member.portrait ? (
        <div class="mx-person__portrait">
          <PhotoFrame src={member.portrait} alt={member.name} ratio="1" sizes="(max-width: 600px) 90vw, (max-width: 1024px) 45vw, 400px" />
          <span class="mx-person__hello" aria-hidden="true">Hi, ich bin {member.name.split(' ')[0]}!</span>
        </div>
      ) : (
        <div class="mx-person__tile" role="img" aria-label={`Foto von ${member.name} folgt`}>
          <div class="mx-person__face">
            <span class="mx-person__hello" aria-hidden="true">Hi, ich bin {member.name.split(' ')[0]}!</span>
            <span class="mx-person__spin" data-play="spin">
              <Icon name="xmark" class="mx-person__mark" />
            </span>
          </div>
        </div>
      )}
      <div class="mx-person__name">{member.name}</div>
      <div class="mx-person__role">{member.role}</div>
    </article>
  )
}

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.mx-person').forEach((card) => {
    let bounds: DOMRect | null = null;
    card.addEventListener('pointerenter', () => { bounds = card.getBoundingClientRect(); });
    card.addEventListener('pointermove', (event) => {
      if (motion.matches || event.pointerType !== 'mouse' || !bounds) return;
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      card.style.setProperty('--tilt-x', `${-y * 10}deg`);
      card.style.setProperty('--tilt-y', `${x * 12}deg`);
    });
    card.addEventListener('pointerleave', () => {
      bounds = null;
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
    });
  });
</script>

<style>
  .mx-person {
    display: block;
    text-align: center;
    color: inherit;
    text-decoration: none;
  }

  .mx-person__portrait { position: relative; }

  .mx-person__tile {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1;
  }
  /* The face sits above the offset block (which paints over the tile's own ground). */
  .mx-person__face {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--white);
  }
  .mx-person__tile::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--accent);
    transform: translate(calc(-1 * var(--photo-offset)), var(--photo-offset));
  }

  .mx-person__spin { display: grid; place-items: center; width: 34%; transform-origin: 50% 50%; }
  .mx-person__tile :global(.mx-person__mark) {
    width: 100%;
    height: auto;
    color: var(--accent);
  }

  .mx-person__tile--open::before { background: var(--yellow-500); }
  .mx-person__tile :global(.mx-person__sticker) {
    width: 62%;
    height: auto;
    transition: transform var(--motion-slow) var(--ease-matrix);
  }
  .mx-person--open:hover :global(.mx-person__sticker) {
    transform: rotate(var(--tilt-hover)) translateY(var(--lift-hover));
  }

  .mx-person__name {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.05;
  }
  .mx-person--open .mx-person__name { color: var(--accent-strong); }

  .mx-person__role {
    font-size: 15px;
    line-height: 22px;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .mx-person__hello {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    left: 50%;
    bottom: 18px;
    width: max-content;
    max-width: calc(100% - 24px);
    padding: 8px 14px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--yellow-500);
    font: 22px/1.1 var(--font-display);
    opacity: 0;
    transform: translate(-50%, 8px) rotate(-4deg);
    transition: opacity .2s, transform .25s var(--ease-matrix);
  }
  .mx-person:is(:hover, :focus-visible, :focus-within) .mx-person__hello {
    opacity: 1;
    transform: translate(-50%, 0) rotate(-4deg);
  }
  .mx-person__name { transition: color .2s; }
  .mx-person:is(:hover, :focus-visible, :focus-within) .mx-person__name { color: var(--accent-strong); }
  @media (prefers-reduced-motion: no-preference) {
    .mx-person__tile, .mx-person :global(.mx-photo) {
      transition: transform .25s var(--ease-matrix);
    }
    .mx-person:is(:hover, :focus-visible, :focus-within) .mx-person__tile,
    .mx-person:is(:hover, :focus-visible, :focus-within) :global(.mx-photo) {
      transform: perspective(700px) rotateX(var(--tilt-x, -3deg)) rotateY(var(--tilt-y, 5deg)) translateY(-8px);
    }
    .mx-person__spin { transition: rotate .4s var(--ease-matrix), scale .4s var(--ease-matrix); }
    .mx-person:is(:hover, :focus-visible, :focus-within) .mx-person__spin { rotate: -12deg; scale: 1.12; }
    .mx-person:nth-child(even):is(:hover, :focus-visible, :focus-within) .mx-person__spin { rotate: 12deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-person__hello { transition: none; }
    .mx-person__tile :global(.mx-person__sticker) { transition: none; }
  }
</style>
