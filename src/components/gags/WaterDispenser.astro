---
/**
 * Theke & Küche: the X-Bar's water dispenser to play with. Hold one of the
 * four buttons (cold, medium, strong sparkling, room temperature) to fill the
 * glass. Fresh water lands as a thin band on top and blends into the glass,
 * so switching buttons mixes: the colour and the two kinds of bubbles follow
 * the shares. A full glass is drunk and refilled. Modelled on the real
 * dispenser, without its labels.
 */
const waters = [
  { kind: 'cold', label: 'Kalt', name: 'kalt', icon: 'snow' },
  { kind: 'medium', label: 'Medium', name: 'medium', icon: 'medium' },
  { kind: 'strong', label: 'Spritzig', name: 'spritzig', icon: 'strong' },
  { kind: 'room', label: 'Zimmerwarm', name: 'zimmerwarm', icon: 'room' },
] as const;
---

<figure class="gag-water" data-water>
  <div class="gag-water__machine">
    <div class="gag-water__tank" aria-hidden="true"></div>
    <div class="gag-water__head">
      <div class="gag-water__screen" aria-hidden="true">
        <span class="gag-water__gauge"><i data-water-gauge></i></span>
      </div>
      <div class="gag-water__buttons" role="group" aria-label="Wasser zapfen: Taste gedrückt halten">
        {waters.map((water) => (
          <button type="button" class="gag-water__button" data-water-kind={water.kind} data-water-name={water.name} aria-label={water.label}>
            {water.icon === 'snow' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M3.3 7l17.4 10M3.3 17 20.7 7M9 3.5l3 2.5 3-2.5M9 20.5l3-2.5 3 2.5M4 10.4l3.8.6-1.4 3.6M20 13.6l-3.8-.6 1.4-3.6M4 13.6l3.8-.6-1.4-3.6M20 10.4l-3.8.6 1.4 3.6" /></svg>
            )}
            {water.icon === 'medium' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" class="is-dots"><circle cx="13" cy="7" r="1.8" /><circle cx="10" cy="15" r="2.8" /></svg>
            )}
            {water.icon === 'strong' && (
              <svg viewBox="0 0 24 24" aria-hidden="true" class="is-dots"><circle cx="11" cy="4.5" r="1.5" /><circle cx="16" cy="8.5" r="1.5" /><circle cx="8" cy="11" r="1.8" /><circle cx="15" cy="14" r="1.8" /><circle cx="11" cy="19" r="2.6" /></svg>
            )}
            {water.icon === 'room' && (
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13c2.5-3 5-3 7.5 0s5 3 7.5 0 2-2 3-2" /></svg>
            )}
          </button>
        ))}
      </div>
    </div>
    <div class="gag-water__bay">
      <span class="gag-water__nozzle" aria-hidden="true"></span>
      <span class="gag-water__stream" data-water-stream aria-hidden="true"></span>
      <div class="gag-water__glass" data-water-glass role="img" aria-label="Leeres Glas">
        <div class="gag-water__fill" data-water-fill>
          <div class="gag-water__body" data-water-body><i class="gag-water__fizz is-medium" data-water-fizz="medium"></i><i class="gag-water__fizz is-strong" data-water-fizz="strong"></i></div>
          <div class="gag-water__fresh" data-water-fresh></div>
        </div>
      </div>
      <span class="gag-water__tray" aria-hidden="true"></span>
    </div>
  </div>
  <figcaption>
    <span class="mx-visually-hidden" data-water-status role="status"></span>
    <button type="button" class="gag-water__drink" data-water-drink hidden>Austrinken &amp; neu zapfen</button>
  </figcaption>
</figure>

<script>
  type Kind = 'cold' | 'medium' | 'strong' | 'room';
  const KINDS: Kind[] = ['cold', 'medium', 'strong', 'room'];
  const RATE = 24; // percent of the glass per second
  const SPLASH = 4; // percent poured by every press, however short
  const MIX = 2.5; // how fast fresh water blends in (per second)
  const colours: Record<Kind, [number, number, number]> = {
    cold: [0x86, 0xcd, 0xf5],
    medium: [0xa3, 0xda, 0xf6],
    strong: [0x74, 0xc1, 0xee],
    room: [0xcf, 0xe9, 0xf3],
  };
  const css = (c: number[]) => `rgb(${c.map(Math.round).join(' ')})`;

  document.querySelectorAll<HTMLElement>('[data-water]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-water-kind]')];
    const fill = root.querySelector<HTMLElement>('[data-water-fill]')!;
    const bodyEl = root.querySelector<HTMLElement>('[data-water-body]')!;
    const freshEl = root.querySelector<HTMLElement>('[data-water-fresh]')!;
    const fizz = [...root.querySelectorAll<HTMLElement>('[data-water-fizz]')];
    const glass = root.querySelector<HTMLElement>('[data-water-glass]')!;
    const stream = root.querySelector<HTMLElement>('[data-water-stream]')!;
    const gauge = root.querySelector<HTMLElement>('[data-water-gauge]')!;
    const status = root.querySelector<HTMLElement>('[data-water-status]')!;
    const drink = root.querySelector<HTMLButtonElement>('[data-water-drink]')!;
    const names = Object.fromEntries(buttons.map((b) => [b.dataset.waterKind, b.dataset.waterName])) as Record<Kind, string>;

    // The mixed water in the glass, per kind, and the fresh band on top.
    const empty = () => Object.fromEntries(KINDS.map((k) => [k, 0])) as Record<Kind, number>;
    let mixed = empty();
    let fresh = { kind: 'cold' as Kind, amount: 0 };
    let pouring: HTMLButtonElement | null = null;
    let last = 0;
    let frame = 0;
    const sum = (shares: Record<Kind, number>) => KINDS.reduce((s, k) => s + shares[k], 0);
    const total = () => sum(mixed) + fresh.amount;

    const shares = () => {
      const all = { ...mixed };
      all[fresh.kind] += fresh.amount;
      return KINDS.map((k) => [k, all[k]] as const).filter(([, v]) => v > 0.5).sort((a, b) => b[1] - a[1]);
    };
    const describe = () => shares().map(([k, v]) => `${Math.round((v / total()) * 100)} % ${names[k]}`).join(', ');

    const render = () => {
      const amount = sum(mixed);
      const colour = amount ? [0, 1, 2].map((i) => KINDS.reduce((c, k) => c + colours[k][i] * mixed[k], 0) / amount) : colours[fresh.kind];
      bodyEl.style.height = `${amount}%`;
      bodyEl.style.backgroundColor = css(colour);
      for (const el of fizz) el.style.opacity = amount ? String(Math.min(1, (mixed[el.dataset.waterFizz as Kind] / amount) * 1.4)) : '0';
      freshEl.style.height = `${fresh.amount}%`;
      for (const k of KINDS) freshEl.classList.toggle(`is-${k}`, k === fresh.kind);
      freshEl.style.backgroundImage = `${getComputedStyle(freshEl).getPropertyValue('--bubbles')}, linear-gradient(to top, ${css(colour)}, ${css(colours[fresh.kind])} 75%)`;
      const level = Math.min(100, total());
      gauge.style.height = `${level}%`;
      stream.style.setProperty('--level', String(level / 100));
      glass.setAttribute('aria-label', level ? `Glas zu ${Math.round(level)} % gefüllt: ${describe()}` : 'Leeres Glas');
    };

    /** Pours water of one kind on top; true once the glass is full. */
    const pour = (kind: Kind, amount: number) => {
      if (fresh.kind !== kind) {
        mixed[fresh.kind] += fresh.amount;
        fresh = { kind, amount: 0 };
      }
      fresh.amount += Math.min(100 - total(), amount);
      return total() >= 99.9;
    };

    /** Blends part of the fresh band into the glass. */
    const blend = (dt: number) => {
      const move = fresh.amount * (1 - Math.exp(-MIX * dt));
      fresh.amount -= move;
      mixed[fresh.kind] += move;
      if (fresh.amount < 0.05) {
        mixed[fresh.kind] += fresh.amount;
        fresh.amount = 0;
      }
    };

    const step = (time: number) => {
      const dt = Math.min(0.1, (time - last) / 1000);
      last = time;
      if (pouring && pour(pouring.dataset.waterKind as Kind, RATE * dt)) {
        stop();
        finish();
      }
      blend(dt);
      render();
      frame = pouring || fresh.amount > 0 ? requestAnimationFrame(step) : 0;
    };
    const run = () => {
      if (frame) return;
      last = performance.now();
      frame = requestAnimationFrame(step);
    };

    function finish() {
      status.textContent = `Glas voll: ${describe()}. Prost!`;
      drink.hidden = false;
      root.classList.add('is-full');
    }

    function start(button: HTMLButtonElement) {
      if (pouring || root.classList.contains('is-full')) return;
      pouring = button;
      button.classList.add('is-on');
      stream.dataset.kind = button.dataset.waterKind;
      root.classList.add('is-pouring');
      // Even a quick tap (or key press) gives a little splash.
      const full = pour(button.dataset.waterKind as Kind, SPLASH);
      render();
      if (full) {
        stop();
        finish();
      }
      run();
    }
    function stop() {
      if (!pouring) return;
      pouring.classList.remove('is-on');
      pouring = null;
      root.classList.remove('is-pouring');
    }

    for (const button of buttons) {
      button.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        button.setPointerCapture(event.pointerId);
        start(button);
      });
      button.addEventListener('pointerup', stop);
      button.addEventListener('pointercancel', stop);
      button.addEventListener('lostpointercapture', stop);
      button.addEventListener('contextmenu', (event) => event.preventDefault());
      button.addEventListener('keydown', (event) => {
        if ((event.key === ' ' || event.key === 'Enter') && !event.repeat) {
          event.preventDefault();
          start(button);
        }
      });
      button.addEventListener('keyup', (event) => {
        if (event.key === ' ' || event.key === 'Enter') stop();
      });
      button.addEventListener('blur', stop);
    }

    drink.addEventListener('click', () => {
      root.classList.remove('is-full');
      drink.hidden = true;
      fill.classList.add('is-drinking');
      const done = () => {
        fill.classList.remove('is-drinking');
        mixed = empty();
        fresh = { kind: 'cold', amount: 0 };
        render();
        status.textContent = 'Glas ist leer.';
        buttons[0].focus({ preventScroll: true });
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
      else window.setTimeout(done, 650);
    });
  });
</script>

<style>
  .gag-water { margin: 0; width: 100%; max-width: 340px; text-align: center; }
  /* Only the refill button shows; the status is for screen readers. */
  .gag-water figcaption { display: grid; justify-items: center; min-height: 42px; margin-top: var(--space-4); }
  .gag-water__drink { padding: 8px 14px 6px; border: 2px solid var(--ink); border-radius: var(--radius-sm); background: var(--yellow-500); color: var(--ink); box-shadow: 0 3px 0 var(--ink); font: 18px/1 var(--font-display); }
  .gag-water__drink[hidden] { display: none; }
  .gag-water__drink:active { translate: 0 2px; box-shadow: 0 1px 0 var(--ink); }
  .gag-water__drink:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  /* ---------- The machine ---------- */
  .gag-water__machine {
    --body: #3a3f45;
    --body-dark: #24282d;
    --glow: #6fc2ff;
    position: relative;
    padding: 0 0 14px;
  }
  .gag-water__tank {
    width: 58%;
    height: 34px;
    margin: 0 auto -2px;
    border: 2.5px solid var(--ink);
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
    background: linear-gradient(90deg, #4b5157, #2f3439 70%);
  }
  .gag-water__head {
    position: relative;
    z-index: 1;
    padding: 16px 16px 14px;
    border: 2.5px solid var(--ink);
    border-radius: 18px 18px 6px 6px;
    background: linear-gradient(90deg, var(--body), var(--body-dark));
    box-shadow: 0 4px 0 var(--ink);
  }
  .gag-water__screen {
    display: grid;
    place-items: center;
    height: 64px;
    margin-bottom: 14px;
    border-radius: 6px;
    background: #121418;
    box-shadow: inset 0 0 0 2px #000;
  }
  .gag-water__gauge { position: relative; display: block; width: 12px; height: 40px; border-radius: 3px; background: #23272d; overflow: hidden; }
  .gag-water__gauge i { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background: var(--glow); box-shadow: 0 0 8px var(--glow); }

  .gag-water__buttons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; justify-items: center; }
  .gag-water__button {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 2px solid #000;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #3b4148, #15181c 70%);
    color: var(--glow);
    box-shadow: 0 3px 0 #000, inset 0 1px 0 rgba(255, 255, 255, 0.15);
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: translate 0.08s ease, box-shadow 0.08s ease;
  }
  .gag-water__button svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 3px var(--glow)); }
  .gag-water__button svg.is-dots { fill: currentColor; stroke: none; }
  .gag-water__button.is-on { translate: 0 2px; box-shadow: 0 1px 0 #000, 0 0 0 3px var(--glow); }
  .gag-water__button:focus-visible { outline: 3px solid var(--yellow-500); outline-offset: 3px; }

  /* ---------- Dispensing bay ---------- */
  .gag-water__bay {
    position: relative;
    height: 220px;
    margin: 0 18px;
    border: 2.5px solid var(--ink);
    border-top: 0;
    border-radius: 0 0 10px 10px;
    background: linear-gradient(90deg, #8b8f92, #c9cbcc 45%, #9a9ea1);
    box-shadow: inset 14px 0 0 var(--body-dark), inset -14px 0 0 var(--body-dark);
  }
  .gag-water__nozzle { position: absolute; left: 50%; top: 0; width: 22px; height: 12px; margin-left: -11px; border-radius: 0 0 6px 6px; background: #2a2e33; }
  .gag-water__tray {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 16px;
    border-top: 2px solid var(--ink);
    background: radial-gradient(circle, #2a2e33 1.6px, transparent 2px) 0 0 / 8px 8px, #4a4f55;
  }

  /* Stream from the nozzle to the surface of the water. */
  .gag-water__stream {
    --level: 0;
    position: absolute;
    left: 50%;
    top: 12px;
    width: 8px;
    margin-left: -4px;
    /* Down to the water: bay minus nozzle, tray and glass padding, minus the fill. */
    height: calc(100% - 36px - 142px * var(--level));
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), #bfe6fb);
    opacity: 0;
    transform-origin: top;
    scale: 1 0;
    transition: opacity 0.12s, scale 0.12s;
  }
  .gag-water__stream[data-kind="room"] { background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), #e2f1f7); }
  .is-pouring .gag-water__stream { opacity: 1; scale: 1 1; }

  .gag-water__glass {
    position: absolute;
    left: 50%;
    bottom: 16px;
    width: 96px;
    height: 150px;
    margin-left: -48px;
    padding: 0 4px 8px;
    border: 3px solid rgba(19, 26, 34, 0.75);
    border-top: 0;
    border-radius: 0 0 14px 14px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.15) 40%, rgba(255, 255, 255, 0.4));
    clip-path: polygon(-10% 0, 110% 0, 96% 100%, 4% 100%);
  }
  .gag-water__fill { display: flex; flex-direction: column-reverse; height: 100%; border-radius: 0 0 9px 9px; overflow: hidden; transition: translate 0.6s var(--ease-matrix); }
  .gag-water__fill.is-drinking { translate: 0 110%; }

  .gag-water__body,
  .gag-water__fresh { position: relative; flex: none; height: 0; overflow: hidden; }
  .gag-water__body { background-color: #bfe6fb; }
  /* Two bubble layers whose opacity follows the medium / strong share. */
  .gag-water__fizz { position: absolute; inset: 0; opacity: 0; transition: opacity 0.3s; }
  .gag-water__fizz.is-medium,
  .gag-water__fresh.is-medium {
    --bubbles: radial-gradient(circle, rgba(255, 255, 255, 0.95) 1.5px, transparent 2px), radial-gradient(circle, rgba(255, 255, 255, 0.8) 1px, transparent 1.5px);
    background-size: 18px 22px, 26px 30px, auto;
    background-position: 3px 0, 11px 7px, 0 0;
  }
  .gag-water__fizz.is-strong,
  .gag-water__fresh.is-strong {
    --bubbles: radial-gradient(circle, rgba(255, 255, 255, 0.95) 1.5px, transparent 2px), radial-gradient(circle, rgba(255, 255, 255, 0.8) 1px, transparent 1.5px);
    background-size: 9px 11px, 13px 15px, auto;
    background-position: 2px 0, 6px 5px, 0 0;
  }
  .gag-water__fizz { background-image: var(--bubbles); }
  .gag-water__fresh { --bubbles: linear-gradient(transparent, transparent), linear-gradient(transparent, transparent); }

  @media (prefers-reduced-motion: no-preference) {
    .gag-water__fizz.is-medium { animation: gag-water-fizz 2.4s linear infinite; }
    .gag-water__fizz.is-strong { animation: gag-water-fizz 1s linear infinite; }
    /* Fresh water swirls a little while it blends in. */
    .gag-water__fresh { animation: gag-water-swirl 0.5s ease-in-out infinite alternate; }
  }
  @keyframes gag-water-swirl {
    from { background-position-x: 0, 0, 0; }
    to { background-position-x: 4px, -4px, 0; }
  }
  @keyframes gag-water-fizz {
    to { background-position-y: -22px, -30px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gag-water__stream,
    .gag-water__fill,
    .gag-water__button { transition: none; }
  }
</style>
