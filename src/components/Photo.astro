---
/**
 * Optimised photo: AVIF + WebP sources with a JPEG/PNG fallback, generated
 * at build time. Swapping the imported image is all it takes to replace a photo.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The `sizes` attribute — how wide the image renders at each breakpoint. */
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** CSS object-position for the crop, e.g. "50% 30%". */
  position?: string;
}

const {
  src,
  alt,
  sizes,
  widths = [400, 640, 960, 1280, 1600],
  loading = 'lazy',
  fetchpriority,
  class: className,
  position,
} = Astro.props;

const usable = widths.filter((w) => w < src.width);
const finalWidths = [...usable, src.width];
---

<Picture
  src={src}
  alt={alt}
  widths={finalWidths}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={loading}
  decoding={loading === 'eager' ? 'auto' : 'async'}
  fetchpriority={fetchpriority}
  class={className}
  style={position ? `object-position: ${position}` : undefined}
/>
