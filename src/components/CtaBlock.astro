---
/** Closing invitation before the footer: question, one lead sentence, optionally one primary button. */
import Button from './Button.astro';

interface Props {
  title: string;
  lead: string;
  label?: string;
  href?: string;
}

const { title, lead, label, href } = Astro.props;
---

<section class="mx-section">
  <div class="mx-container">
    <div class="mx-cta">
      <h2 class="mx-h2">{title}</h2>
      <p class="mx-lead">{lead}</p>
      {label && href && <Button href={href}>{label}</Button>}
    </div>
  </div>
</section>

<style>
  .mx-cta {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  .mx-cta .mx-lead { margin: var(--space-4) 0 var(--space-6); }
  .mx-cta .mx-lead:last-child { margin-bottom: 0; }

</style>
