---
/**
 * Colour hero of the section pages: accent field + the ready-made hero layer
 * (grainy triangle, confetti, character on the 1920×1020 canvas) + the
 * display title. The layer is centred and never narrower than 1280px, so on
 * phones its edges (and the character) fall outside — there a separate
 * character sticker takes over, overlapping the hero's bottom edge.
 */
import Graphic from './Graphic.astro';
import ScrollCue from './ScrollCue.astro';
import type { GraphicName } from '../data/graphics';
import AngebotArtwork from '../../public/graphics/heroes/angebot-hero-deco.svg';
import RaeumeArtwork from '../../public/graphics/heroes/raeume-hero-deco.svg';
import TeamArtwork from '../../public/graphics/heroes/team-hero-deco.svg';
import AktuellesArtwork from '../../public/graphics/heroes/aktuelles-hero-deco.svg';
import RainbowArtwork from '../../public/graphics/heroes/rainbow-clouds.svg';
import LegalArtwork from '../../public/graphics/heroes/rechtliches-hero-deco.svg';
import SunArtwork from '../../public/graphics/stickers/sun-omg.svg';

interface Props {
  deco: Extract<GraphicName, `${string}-hero-deco` | 'rainbow-clouds'>;
  /** Phone-only character, overlapping the bottom edge. */
  sticker?: GraphicName;
  stickerSide?: 'left' | 'right';
}

const { deco, sticker, stickerSide = 'left' } = Astro.props;
const artworks = {
  'angebot-hero-deco': AngebotArtwork,
  'raeume-hero-deco': RaeumeArtwork,
  'team-hero-deco': TeamArtwork,
  'aktuelles-hero-deco': AktuellesArtwork,
  'rainbow-clouds': RainbowArtwork,
  'rechtliches-hero-deco': LegalArtwork,
};
const Artwork = artworks[deco];
---

<section class:list={["mx-hero", deco === "rechtliches-hero-deco" && "mx-hero--legal", sticker && "mx-hero--has-sticker"]}>
  <div class="mx-hero__deco">
    <Artwork class="mx-hero__artwork" role="group" aria-label="Interaktive Header-Illustration" />
  </div>
  <h1 class="mx-display mx-hero__title"><slot /></h1>
  {sticker === 'sun-omg' ? (
    <SunArtwork class={`mx-hero__sticker mx-hero__sticker--${stickerSide}`} role="group" aria-label="Interaktive Sonne" />
  ) : sticker && <Graphic name={sticker} class={`mx-hero__sticker mx-hero__sticker--${stickerSide}`} />}
  <ScrollCue />
</section>

<style>
  .mx-hero {
    position: relative;
    background: var(--accent);
    height: clamp(600px, 46.875vw, 900px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--nav-height) var(--page-margin) 0;
    overflow-x: clip;
  }

  .mx-hero__deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mx-hero__deco :global(.mx-hero__artwork) {
    position: absolute;
    left: 50%;
    top: 0;
    width: max(1280px, 100%);
    height: auto;
    max-width: none;
    transform: translateX(-50%);
    overflow: visible;
  }

  .mx-hero--legal { z-index: 1; overflow: visible; }

  .mx-hero__title {
    position: relative;
    z-index: 2;
    overflow-wrap: break-word;
  }

  .mx-hero :global(.mx-hero__sticker) {
    display: none;
    position: absolute;
    z-index: 3;
    bottom: -60px;
    width: 150px;
    height: auto;
    pointer-events: none;
  }
  .mx-hero :global(.mx-hero__sticker--left) { left: 16px; }
  .mx-hero :global(.mx-hero__sticker--right) { right: 16px; }

  @media (max-width: 860px) {
    .mx-hero { height: 560px; }
    .mx-hero :global(.mx-hero__sticker) { display: block; }
    .mx-hero--has-sticker .mx-hero__deco :global([data-play]),
    .mx-hero--has-sticker .mx-hero__deco :global([data-speech-subject]) { display: none; }
  }
  :global([data-play][role="button"]) { transform-box: fill-box; }
  :global([data-speech-bubble]) { opacity: 0; pointer-events: none; }
  :global([data-speech-subject].is-speaking > [data-speech-bubble]) { opacity: 1; }
  :global([data-play][role="button"]:focus-visible) { outline: 3px solid var(--ink); outline-offset: 5px; }
  :global([data-play][role="button"]:focus:not(:focus-visible)) { outline: none; }
</style>
