---
/**
 * Month calendar for Aktuelles: the grid on a white panel with the hard ink
 * drop, the picked day (or the month's events) on an accent panel beside it.
 * The empty month is rendered at build time; the dates arrive from the live
 * calendar (src/scripts/calendar-data.ts) and fill grid and agenda.
 */
import Button from './Button.astro';
import Dynamic from './php/Dynamic.astro';
import PhpTemplate from './php/PhpTemplate.astro';
import { monthTitle, renderMonth } from '../scripts/event-calendar';

interface Props {
  /** Today at build time, YYYY-MM-DD; the browser corrects it. */
  today: string;
}

const { today } = Astro.props;
const weekdays = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'];
---

<div class="mx-cal" data-today={today}>
  <div class="mx-cal__board">
    <div class="mx-cal__head">
      <h3 class="mx-cal__month" aria-live="polite" set:html={monthTitle(today)} />
      <div class="mx-cal__nav">
        <button type="button" class="mx-cal__arrow" data-cal="prev" aria-label="Vorheriger Monat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
        </button>
        <Button size="sm" variant="outline" class="mx-cal__today" data-cal="today">Heute</Button>
        <button type="button" class="mx-cal__arrow" data-cal="next" aria-label="Nächster Monat">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
        </button>
      </div>
    </div>
    <div class="mx-cal__weekdays" aria-hidden="true">
      {weekdays.map((d) => <span>{d}</span>)}
    </div>
    <div class="mx-cal__grid" set:html={renderMonth(new Map(), { month: today, today })} />
    <div class="mx-cal__foot">
      <p class="mx-cal__legend">
        <span><i></i>Event</span>
        <span><i class="is-weekly"></i>Jede Woche</span>
      </p>
      <Dynamic render="calendar_subscribe" />
      <PhpTemplate name="calendar-subscribe">
        <a class="mx-link mx-small" href="%%url%%" rel="noopener">Kalender abonnieren</a>
      </PhpTemplate>
    </div>
  </div>
  <section class="mx-cal__agenda" aria-live="polite" aria-label="Termine">
    <p class="mx-cal__empty">Termine werden geladen …</p>
  </section>
</div>

<script>
  import type { CalendarEvent } from '../data/events';
  import { loadEvents } from '../scripts/calendar-data';
  import { indexByDay, monthTitle, renderAgenda, renderMonth, type MonthView } from '../scripts/event-calendar';

  for (const root of document.querySelectorAll<HTMLElement>('.mx-cal')) {
    let events: CalendarEvent[] = [];
    let byDay = indexByDay(events);
    let failed = false;
    const grid = root.querySelector<HTMLElement>('.mx-cal__grid')!;
    const agenda = root.querySelector<HTMLElement>('.mx-cal__agenda')!;
    const title = root.querySelector<HTMLElement>('.mx-cal__month')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-cal="prev"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-cal="next"]')!;

    // The visitor's today in Königsbrunn, which may be later than the build.
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(new Date());
    let firstMonth = today.slice(0, 7);
    let lastMonth = today.slice(0, 7);
    const view: MonthView = { month: `${today.slice(0, 7)}-01`, today };
    const stacked = matchMedia('(max-width: 1024px)');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const render = (focusDay?: string) => {
      title.innerHTML = monthTitle(view.month);
      grid.innerHTML = renderMonth(byDay, view);
      agenda.innerHTML = failed
        ? '<p class="mx-cal__empty">Der Kalender ist gerade nicht erreichbar. Versuch es später noch einmal.</p>'
        : renderAgenda(byDay, view);
      const cards = agenda.querySelector<HTMLElement>('.mx-cal__cards');
      cards?.classList.toggle('is-scrollable', cards.scrollHeight > cards.clientHeight + 4);
      prev.disabled = view.month.slice(0, 7) <= firstMonth;
      next.disabled = view.month.slice(0, 7) >= lastMonth;
      if (focusDay) grid.querySelector<HTMLElement>(`[data-day="${focusDay}"]`)?.focus();
    };

    const shiftMonth = (by: number) => {
      const [y, m] = view.month.split('-').map(Number);
      const d = new Date(Date.UTC(y, m - 1 + by, 1));
      view.month = d.toISOString().slice(0, 10);
      view.selected = undefined;
      render();
    };

    root.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('[data-day], [data-cal]');
      if (!target) return;
      const action = target.dataset.cal;
      if (action === 'prev') shiftMonth(-1);
      else if (action === 'next') shiftMonth(1);
      else if (action === 'month') {
        const day = view.selected;
        view.selected = undefined;
        render(day);
      } else if (action === 'today') {
        view.month = `${today.slice(0, 7)}-01`;
        view.selected = today;
        render(today);
      } else if (target.dataset.day) {
        const day = target.dataset.day;
        view.selected = view.selected === day ? undefined : day;
        render(day);
        // On stacked layouts the agenda sits below the grid: bring it into view.
        if (view.selected && stacked.matches && agenda.getBoundingClientRect().top > innerHeight * 0.75) {
          agenda.scrollIntoView({ block: 'nearest', behavior: reduceMotion.matches ? 'auto' : 'smooth' });
        }
      }
    });

    // Arrow keys move between days, across month edges too.
    grid.addEventListener('keydown', (e) => {
      const day = (e.target as HTMLElement).dataset.day;
      const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[e.key];
      if (!day || !step) return;
      e.preventDefault();
      const d = new Date(`${day}T12:00:00Z`);
      d.setUTCDate(d.getUTCDate() + step);
      const iso = d.toISOString().slice(0, 10);
      if (iso.slice(0, 7) < firstMonth || iso.slice(0, 7) > lastMonth) return;
      if (iso.slice(0, 7) !== view.month.slice(0, 7)) {
        view.month = `${iso.slice(0, 7)}-01`;
        view.selected = undefined;
        render(iso);
      } else grid.querySelector<HTMLElement>(`[data-day="${iso}"]`)?.focus();
    });

    render();
    agenda.innerHTML = '<p class="mx-cal__empty">Termine werden geladen …</p>';
    loadEvents()
      .then((loaded) => {
        events = loaded;
        byDay = indexByDay(events);
        const months = events.map((ev) => ev.date.slice(0, 7)).sort();
        firstMonth = [months[0], today.slice(0, 7)].filter(Boolean).sort()[0];
        lastMonth = [months[months.length - 1], today.slice(0, 7)].filter(Boolean).sort().pop()!;
      })
      .catch(() => { failed = true; })
      .finally(() => render());
  }
</script>

<style is:global>
  .mx-cal {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, 1fr);
    gap: var(--space-6);
    align-items: start;
    text-align: left;
    color: var(--ink);
  }

  /* ---------- Board (month grid) ---------- */
  .mx-cal__board {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-press);
  }

  .mx-cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .mx-cal__month {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    line-height: 1;
    color: var(--ink);
  }
  .mx-cal__month span { color: var(--accent-strong); }

  .mx-cal__nav { display: flex; align-items: center; gap: var(--space-3); }

  .mx-cal__arrow {
    --arrow-drop: var(--press-drop-rest);
    --arrow-y: 0px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--accent-strong);
    color: var(--white);
    box-shadow: 0 var(--arrow-drop) 0 var(--ink);
    transform: translateY(var(--arrow-y));
    transition:
      transform var(--motion-fast) var(--ease-matrix),
      box-shadow var(--motion-fast) var(--ease-matrix),
      opacity var(--motion-fast) var(--ease-matrix);
  }
  .mx-cal__arrow svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) {
    .mx-cal__arrow:hover:not(:disabled) { --arrow-drop: var(--press-drop-hover); --arrow-y: var(--press-lift-hover); }
  }
  .mx-cal__arrow:active:not(:disabled) { --arrow-drop: var(--press-drop-active); --arrow-y: var(--press-sink-active); }
  .mx-cal__arrow:disabled { opacity: 0.35; }
  .mx-cal__arrow:focus-visible,
  .mx-cal__day:focus-visible,
  .mx-cal__back:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }

  .mx-cal__weekdays,
  .mx-cal__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
  }

  .mx-cal__weekdays {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1;
    color: var(--ink-muted);
    text-align: center;
  }
  .mx-cal__weekdays span:nth-child(n + 6) { color: var(--accent-strong); }

  /* ---------- Days ---------- */
  .mx-cal__day {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    min-height: 92px;
    padding: 8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--ink-scrim-soft);
    color: var(--ink);
    font: inherit;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform var(--motion-fast) var(--ease-matrix),
      rotate var(--motion-fast) var(--ease-matrix),
      box-shadow var(--motion-fast) var(--ease-matrix),
      background var(--motion-fast) var(--ease-matrix);
  }
  .mx-cal__day--blank { background: transparent; }
  .mx-cal__day.is-past { opacity: 0.5; }
  .mx-cal__day.has-event { background: var(--accent-tint); box-shadow: inset 0 0 0 2px color-mix(in oklab, var(--accent) 55%, var(--white)); }

  @media (hover: hover) {
    .mx-cal__day:not(.mx-cal__day--blank):hover {
      transform: translateY(-2px);
      box-shadow: inset 0 0 0 2px var(--ink), 0 4px 0 var(--ink);
    }
    .mx-cal__grid > :nth-child(odd).mx-cal__day:hover { rotate: -1.5deg; }
    .mx-cal__grid > :nth-child(even).mx-cal__day:hover { rotate: 1.5deg; }
  }

  .mx-cal__day.is-selected,
  .mx-cal__day.is-selected:hover {
    background: var(--accent);
    box-shadow: inset 0 0 0 3px var(--ink), 0 4px 0 var(--ink);
    transform: translateY(-2px);
    opacity: 1;
  }

  .mx-cal__num {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 32px;
    padding: 2px 4px 0;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1;
  }
  .mx-cal__day.is-today .mx-cal__num { background: var(--ink); color: var(--white); }

  .mx-cal__chips { display: flex; flex-direction: column; gap: 3px; width: 100%; min-width: 0; }

  .mx-cal__chip {
    overflow: hidden;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--accent-strong);
    color: var(--white);
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .mx-cal__day.is-selected .mx-cal__chip { background: var(--ink); }
  .mx-cal__more { font-size: 12px; font-weight: 700; line-height: 1; color: var(--accent-strong); }
  .mx-cal__day.is-selected .mx-cal__more { color: var(--ink); }

  /* Dots: weekly dates on the wide grid, everything on phones. */
  .mx-cal__dots { position: absolute; top: 12px; right: 10px; display: flex; gap: 3px; }
  .mx-cal__dots i,
  .mx-cal__legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-strong);
  }
  .mx-cal__dots i.is-weekly,
  .mx-cal__legend i.is-weekly { background: transparent; box-shadow: inset 0 0 0 2px var(--ink-muted); }
  .mx-cal__day.is-selected .mx-cal__dots i.is-weekly { box-shadow: inset 0 0 0 2px var(--ink); }
  .mx-cal__dots i:not(.is-weekly) { display: none; }

  .mx-cal__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
  }

  .mx-cal__legend { display: flex; gap: var(--space-5); margin: 0; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--ink-muted); }
  .mx-cal__legend span { display: inline-flex; align-items: center; gap: var(--space-2); }
  .mx-cal__legend i { display: inline-block; width: 10px; height: 10px; }

  /* ---------- Agenda ---------- */
  .mx-cal__agenda {
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--accent);
    box-shadow: var(--shadow-press);
  }

  /* Side by side, the agenda is exactly as tall as the month grid; a long
     list scrolls inside it, fading out at the bottom. */
  @media (min-width: 1025px) {
    .mx-cal { align-items: stretch; }
    .mx-cal__agenda {
      contain: size;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .mx-cal__agenda .mx-cal__cards {
      flex: 1;
      min-height: 0;
      align-content: start;
      overflow-y: auto;
      overscroll-behavior: contain;
      /* Room for the cards' tilt and drop shadow inside the scroll area. */
      margin: calc(-1 * var(--space-2)) calc(-1 * var(--space-3)) 0;
      padding: var(--space-2) var(--space-3) var(--space-6);
      scrollbar-width: thin;
      scrollbar-color: var(--ink) transparent;
      mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent);
    }
    .mx-cal__agenda .mx-cal__cards:not(.is-scrollable) { mask-image: none; }
    .mx-cal__agenda .mx-cal__back { flex: none; }
  }

  .mx-cal__agenda-title {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
    line-height: 1.1;
  }

  .mx-cal__cards { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }

  .mx-cal__card {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: 0 3px 0 var(--ink);
    transition: rotate var(--motion-fast) var(--ease-matrix), transform var(--motion-fast) var(--ease-matrix);
  }
  .mx-cal__card:nth-child(odd) { rotate: -0.6deg; }
  .mx-cal__card:nth-child(even) { rotate: 0.6deg; }
  @media (hover: hover) {
    .mx-cal__card:hover { rotate: 0deg; transform: translateY(-2px); }
  }
  .mx-cal__card.is-weekly { background: color-mix(in oklab, var(--white) 82%, var(--accent)); }

  .mx-cal__card-time {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.1;
    color: var(--accent-strong);
  }
  .mx-cal__card-date { color: var(--ink); }

  .mx-cal__card-title { margin: 0; font-size: var(--fs-body); font-weight: 700; line-height: 1.3; }
  .mx-cal__card-meta { margin: 2px 0 0; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--ink-muted); }
  .mx-cal__card-text { margin: var(--space-2) 0 0; font-size: var(--fs-small); line-height: var(--lh-small); overflow-wrap: anywhere; }
  .mx-cal__card-text a { color: var(--accent-strong); font-weight: 700; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .mx-cal__card-link {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--accent-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .mx-cal__empty { margin: 0; padding: var(--space-4) var(--space-5); border-radius: var(--radius-md); background: color-mix(in oklab, var(--white) 70%, transparent); font-size: var(--fs-small); line-height: var(--lh-small); }

  .mx-cal__back {
    margin-top: var(--space-5);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* ---------- Smaller screens ---------- */
  @media (max-width: 1024px) {
    .mx-cal { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .mx-cal__board,
    .mx-cal__agenda { padding: var(--space-5) var(--space-4); }
    .mx-cal__head { flex-wrap: wrap; }
    .mx-cal__nav { gap: var(--space-2); }
    .mx-cal__weekdays,
    .mx-cal__grid { gap: 4px; }
    .mx-cal__weekdays { font-size: 17px; }
    .mx-cal__day { align-items: center; justify-content: center; gap: 2px; min-height: 0; aspect-ratio: 1; padding: 2px; }
    .mx-cal__num { min-width: 28px; height: 28px; font-size: 19px; }
    .mx-cal__chips { display: none; }
    .mx-cal__dots { position: static; }
    .mx-cal__dots i { width: 6px; height: 6px; }
    .mx-cal__dots i:not(.is-weekly) { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-cal__arrow,
    .mx-cal__day,
    .mx-cal__card { transition: none; }
  }
</style>
