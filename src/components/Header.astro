---
/**
 * Floating white nav bar laid over every hero. Under 860px the links and CTA
 * collapse into the ink burger, which opens a full-screen purple sheet.
 */
import Logo from './Logo.astro';
import Button from './Button.astro';
import Graphic from './Graphic.astro';
import { mainNav, ctaNav } from '../data/site';

interface Props {
  /** Key of the current page (see mainNav) for aria-current. */
  current?: string;
}

const { current } = Astro.props;
const isCurrent = (key: string) => key === current;
---

<header class="mx-nav" data-nav>
  <div class="mx-container">
    <nav class="mx-nav__bar" aria-label="Hauptnavigation">
      <Logo />
      <ul class="mx-nav__links">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.key) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mx-nav__cta">
        <Button href={ctaNav.href} size="sm" aria-current={isCurrent(ctaNav.key) ? 'page' : undefined}>
          {ctaNav.label}
        </Button>
      </div>
      <button class="mx-nav__burger" type="button" aria-label="Menü öffnen" aria-haspopup="dialog" aria-controls="mx-menu" aria-expanded="false" data-menu-open>
        <span></span>
      </button>
    </nav>
  </div>

  <dialog class="mx-sheet" id="mx-menu" aria-label="Menü" data-accent="purple">
    <div class="mx-sheet__inner mx-container">
      <div class="mx-sheet__top">
        <Logo onDark />
        <button class="mx-sheet__close" type="button" aria-label="Menü schließen" data-menu-close>
          <span></span>
        </button>
      </div>
      <ul class="mx-sheet__links">
        {
          mainNav.map((item) => (
            <li>
              <a class="mx-h2" href={item.href} aria-current={isCurrent(item.key) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={ctaNav.href} variant="inverse">{ctaNav.label}!</Button>
      <Graphic name="cat-hi" class="mx-sheet__sticker" />
    </div>
  </dialog>
</header>

<script>
  // Sticky behaviour: lifted shadow once scrolled; hidden while scrolling
  // down (past the hero), shown again on any scroll up or focus.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-scrolled', y > 24);
      if (nav.contains(document.activeElement) || document.documentElement.classList.contains('mx-menu-open')) {
        nav.classList.remove('is-hidden');
      } else if (y > lastY + 6 && y > 320) {
        nav.classList.add('is-hidden');
      } else if (y < lastY - 6 || y <= 320) {
        nav.classList.remove('is-hidden');
      }
      lastY = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    nav.addEventListener('focusin', () => nav.classList.remove('is-hidden'));
    onScroll();
  }

  const sheet = document.querySelector<HTMLDialogElement>('#mx-menu');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closer = sheet?.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (sheet && opener) {
    const setOpen = (open: boolean) => {
      opener.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('mx-menu-open', open);
    };

    opener.addEventListener('click', () => {
      sheet.showModal();
      setOpen(true);
    });
    closer?.addEventListener('click', () => sheet.close());
    sheet.addEventListener('close', () => setOpen(false));

    // Following an in-page link (e.g. Kontakt) closes the sheet first.
    sheet.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => sheet.close()));

    // Leaving the burger breakpoint with the sheet open: close it.
    const desktop = window.matchMedia('(min-width: 861px)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && sheet.open) sheet.close();
    });
  }
</script>

<style>
  /* Floats over the hero at first, then stays with you: out of the way while
     you scroll down, back as soon as you scroll up. */
  .mx-nav {
    position: fixed;
    z-index: 20;
    top: var(--space-4);
    left: 0;
    right: 0;
    pointer-events: none;
    transition: translate 0.28s var(--ease-matrix);
  }
  .mx-nav > .mx-container { pointer-events: auto; }
  .mx-nav.is-hidden { translate: 0 calc(-100% - var(--space-6)); }

  .mx-nav__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--nav-height);
    padding: 0 var(--space-3) 0 var(--space-5);
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-press);
    view-transition-name: mx-nav;
    transition: box-shadow var(--motion-slow) var(--ease-matrix);
  }
  /* Same size everywhere; over content it just gets a soft lift. */
  .mx-nav.is-scrolled .mx-nav__bar {
    box-shadow: var(--shadow-press), var(--shadow-float);
  }

  .mx-nav__links {
    display: flex;
    gap: var(--space-6);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .mx-nav__links a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    line-height: 1;
    padding: 6px 0;
  }

  .mx-nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 4px;
    border-radius: 4px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-normal) var(--ease-matrix);
  }

  .mx-nav__links a:hover::after,
  .mx-nav__links a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .mx-nav__burger,
  .mx-sheet__close {
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--ink);
    color: var(--white);
    align-items: center;
    justify-content: center;
  }

  .mx-nav__burger {
    display: none;
    margin-left: auto;
  }

  .mx-nav__burger span,
  .mx-nav__burger span::before,
  .mx-nav__burger span::after {
    display: block;
    width: 20px;
    height: 3px;
    border-radius: 2px;
    background: currentColor;
    position: relative;
    content: "";
  }
  .mx-nav__burger span::before { position: absolute; top: -7px; }
  .mx-nav__burger span::after { position: absolute; top: 7px; }

  @media (max-width: 860px) {
    .mx-nav__links,
    .mx-nav__cta { display: none; }
    .mx-nav__burger { display: inline-flex; }
  }

  /* ---------- Mobile sheet ---------- */
  .mx-sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--purple-500);
    color: var(--white);
    overflow: hidden auto;
    overscroll-behavior: contain;
    pointer-events: auto;
  }
  .mx-sheet::backdrop { background: var(--purple-500); }

  .mx-sheet[open] { animation: mx-sheet-in var(--motion-slow) var(--ease-matrix); }

  @keyframes mx-sheet-in {
    from { transform: translateY(-24px); }
    to { transform: translateY(0); }
  }

  .mx-sheet__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 100%;
    padding-top: var(--space-4);
    padding-bottom: var(--space-9);
  }

  .mx-sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: var(--nav-height);
    padding: 0 var(--space-3) 0 var(--space-5);
  }

  .mx-sheet__close {
    display: inline-flex;
    position: relative;
  }
  .mx-sheet__close span::before,
  .mx-sheet__close span::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    height: 3px;
    margin: -1.5px 0 0 -11px;
    border-radius: 2px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .mx-sheet__close span::after { transform: rotate(-45deg); }

  .mx-sheet__links {
    list-style: none;
    margin: var(--space-7) 0 var(--space-7);
    padding: 0 var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .mx-sheet__links a {
    color: var(--white);
    text-decoration: none;
    text-decoration-thickness: 4px;
    text-underline-offset: 8px;
  }
  .mx-sheet__links a[aria-current="page"],
  .mx-sheet__links a:hover {
    text-decoration-line: underline;
    text-decoration-color: var(--ink);
  }

  .mx-sheet__inner > :global(.mx-btn) { margin-left: var(--space-5); }

  .mx-sheet :global(.mx-sheet__sticker) {
    position: absolute;
    right: var(--page-margin);
    bottom: var(--space-6);
    width: clamp(120px, 34vw, 190px);
    height: auto;
    pointer-events: none;
  }

  :global(html.mx-menu-open) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .mx-nav,
    .mx-nav__bar { transition: none; }
    .mx-nav__links a::after { transition: none; }
    .mx-sheet[open] { animation: none; }
  }
</style>
