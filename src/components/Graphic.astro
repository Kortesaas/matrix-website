---
/**
 * Decorative sticker, shape or hero layer from the handoff artwork (never redrawn).
 * Characters are playable by default (see Play.astro): they react to hover and
 * clicks and give the hand cursor its own easter-egg state.
 */
import { graphics, type GraphicName } from '../data/graphics';

export type PlayKind = 'pet' | 'hot' | 'love' | 'snap' | 'spin';

const defaultPlay: Partial<Record<GraphicName, PlayKind>> = {
  'cat-hi': 'pet',
  'dino-pez': 'pet',
  'dino-wave': 'pet',
  'egg-hi': 'pet',
  'skater-yeah': 'pet',
  'dino-camera': 'snap',
  'sun-omg': 'hot',
  flame: 'hot',
  flowers: 'love',
  'daisy-face': 'love',
  'flower-face': 'love',
  'heart-bubble': 'love',
  'x-mark': 'spin',
};

interface Props {
  name: GraphicName;
  class?: string;
  style?: string;
  /** Leave empty for decoration (the default). */
  alt?: string;
  loading?: 'lazy' | 'eager';
  /** Override the sticker's reaction, or `false` to keep it still (e.g. inside a link). */
  play?: PlayKind | false;
}

const { name, class: className, style, alt = '', loading = 'lazy', play } = Astro.props;
const g = graphics[name];
const kind = play === false ? undefined : (play ?? defaultPlay[name]);
---

<img
  class={className}
  style={style}
  src={g.src}
  width={g.width}
  height={g.height}
  alt={alt}
  aria-hidden={alt ? undefined : 'true'}
  loading={loading}
  decoding="async"
  data-play={kind}
  draggable={kind ? 'false' : undefined}
/>
