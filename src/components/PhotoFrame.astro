---
/**
 * The brand's photo treatment: a square-cornered photo on a solid colour
 * block offset by 12px (8px on phones). No rounded corners, no soft shadows.
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import type { Accent } from '../data/site';

export type Offset = 'bl' | 'br' | 'tr' | 'tl';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  /** Aspect ratio of the crop: 1, 4/3, 3/2, 16/9 … */
  ratio?: string;
  /** Direction of the offset block. Alternate down a page. */
  offset?: Offset;
  /** Group photos only (landing / team teaser). */
  tilt?: 'l' | 'r';
  /** Block colour; defaults to the nearest --accent. */
  frame?: Accent;
  position?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  sizes,
  ratio = '1',
  offset = 'bl',
  tilt,
  frame,
  position,
  loading,
  class: className,
} = Astro.props;

const style = [`--ratio: ${ratio}`, frame && `--frame: var(--${frame}-500)`].filter(Boolean).join('; ');
---

<figure
  class:list={['mx-photo', offset !== 'bl' && `mx-photo--${offset}`, tilt && `mx-photo--tilt-${tilt}`, className]}
  style={style}
>
  <Photo src={src} alt={alt} sizes={sizes} position={position} loading={loading} />
</figure>

<style>
  .mx-photo {
    --ox: calc(-1 * var(--photo-offset));
    --oy: var(--photo-offset);
    position: relative;
    margin: 0;
    isolation: isolate;
  }
  .mx-photo::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--frame, var(--accent));
    transform: translate(var(--ox), var(--oy));
  }
  .mx-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--ratio, 1);
  }
  .mx-photo--br { --ox: var(--photo-offset); --oy: var(--photo-offset); }
  .mx-photo--tr { --ox: var(--photo-offset); --oy: calc(-1 * var(--photo-offset)); }
  .mx-photo--tl { --ox: calc(-1 * var(--photo-offset)); --oy: calc(-1 * var(--photo-offset)); }
  .mx-photo--tilt-l { transform: rotate(var(--tilt-l)); }
  .mx-photo--tilt-r { transform: rotate(var(--tilt-r)); }
</style>
