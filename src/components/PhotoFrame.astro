---
/**
 * The brand's photo treatment: a square-cornered photo on a solid colour
 * block offset by 12px (8px on phones). No rounded corners, no soft shadows.
 */
import type { ImageMetadata } from 'astro';
import Photo, { type UploadedPhoto } from './Photo.astro';
import type { Accent } from '../data/site';

export type Offset = 'bl' | 'br' | 'tr' | 'tl';

interface Props {
  src: ImageMetadata | UploadedPhoto;
  alt: string;
  sizes: string;
  /** Aspect ratio of the crop: 1, 4/3, 3/2, 16/9 … */
  ratio?: string;
  /** Direction of the offset block. Alternate down a page. */
  offset?: Offset;
  /** Group photos only (landing / team teaser). */
  tilt?: 'l' | 'r';
  /** Block colour; defaults to the nearest --accent. */
  frame?: Accent;
  position?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  /** False when a containing link already provides the action. */
  interactive?: boolean;
}

const {
  src,
  alt,
  sizes,
  ratio = '1',
  offset = 'bl',
  tilt,
  frame,
  position,
  loading,
  interactive = true,
  class: className,
} = Astro.props;

const style = [`--ratio: ${ratio}`, frame && `--frame: var(--${frame}-500)`].filter(Boolean).join('; ');
---

<figure
  class:list={['mx-photo', offset !== 'bl' && `mx-photo--${offset}`, tilt && `mx-photo--tilt-${tilt}`, className]}
  style={style}
>
  {interactive ? (
    <button class="mx-photo__open" type="button" data-photo-open data-photo-src={src.src} data-photo-alt={alt} aria-label={`Foto vergrößern: ${alt}`}>
      <Photo src={src} alt={alt} sizes={sizes} position={position} loading={loading} />
      <span class="mx-photo__expand" aria-hidden="true">↗</span>
    </button>
  ) : (
    <Photo src={src} alt={alt} sizes={sizes} position={position} loading={loading} />
  )}
</figure>

<style>
  .mx-photo {
    --ox: calc(-1 * var(--photo-offset));
    --oy: var(--photo-offset);
    position: relative;
    margin: 0;
    isolation: isolate;
    aspect-ratio: var(--ratio, 1);
    align-self: start;
  }
  .mx-photo::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--frame, var(--accent));
    transform: translate(var(--ox), var(--oy));
  }
  .mx-photo :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .mx-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: var(--ratio, 1);
  }
  .mx-photo__open { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; overflow: hidden; }
  .mx-photo__expand { position: absolute; right: 12px; bottom: 12px; display: grid; place-items: center; width: 40px; height: 40px; border: 2px solid var(--ink); border-radius: 8px; background: var(--white); color: var(--ink); box-shadow: 3px 3px 0 var(--ink); font: 28px/1 var(--font-display); opacity: 0; translate: 0 6px; transition: opacity .2s, translate .2s; }
  .mx-photo__open:is(:hover, :focus-visible) .mx-photo__expand { opacity: 1; translate: 0 0; }
  .mx-photo__open:active .mx-photo__expand { translate: 2px 2px; box-shadow: 1px 1px 0 var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    .mx-photo__open :global(img) { transition: scale .35s var(--ease-matrix), rotate .35s var(--ease-matrix); }
    .mx-photo__open:is(:hover, :focus-visible) :global(img) { scale: 1.035; rotate: -.4deg; }
  }
  @media (hover: none) { .mx-photo__expand { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .mx-photo__expand { transition: none; } }
  .mx-photo--br { --ox: var(--photo-offset); --oy: var(--photo-offset); }
  .mx-photo--tr { --ox: var(--photo-offset); --oy: calc(-1 * var(--photo-offset)); }
  .mx-photo--tl { --ox: calc(-1 * var(--photo-offset)); --oy: calc(-1 * var(--photo-offset)); }
  .mx-photo--tilt-l { transform: rotate(var(--tilt-l)); }
  .mx-photo--tilt-r { transform: rotate(var(--tilt-r)); }
</style>
