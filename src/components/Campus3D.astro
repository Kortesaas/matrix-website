---
/**
 * The landing page's 3D campus: a toon-rendered diorama of the MatriX
 * (src/scripts/campus) with the site's "+" markers and room cards.
 * The diorama sits directly on its section (transparent canvas) and takes
 * every colour from the page: the hue from --accent, outlines from --ink —
 * change the page accent and the whole diorama follows. On touch screens a
 * tapped marker opens the house as well.
 *
 * Three.js loads only when the section comes near the viewport. Without
 * WebGL (or JavaScript) a plain list of the rooms is shown instead.
 */
import Photo from './Photo.astro';
import CourtIllustration from './CourtIllustration.astro';
import { campusRooms } from '../data/campus';
import { rooms } from '../data/rooms';

// Each card takes the accent of the room page it links to.
const accentFor = (href?: string) => rooms.find((room) => room.href === href)?.accent;
---

<div class="mx-campus" data-campus>
  <div class="mx-campus__panel" role="group" aria-label="Interaktives 3D-Modell der MatriX">
    <div class="mx-campus__viewer" data-campus-viewer>
      <p class="mx-campus__loading">Die kleine MatriX entsteht …</p>
      <svg class="mx-campus__stems" data-campus-stems aria-hidden="true"></svg>

      {
        campusRooms.map((room) => (
          <button
            class="mx-hotspot"
            type="button"
            data-room={room.id}
            data-anchor={JSON.stringify(room.anchor)}
            data-outdoor={room.outdoor ? 'true' : undefined}
            data-href={room.link?.href}
            aria-label={`${room.title} entdecken`}
            aria-expanded="false"
            aria-controls={`mx-campus-card-${room.id}`}
            hidden
          >
            <span aria-hidden="true">+</span>
            <span class="mx-hotspot__label" aria-hidden="true">{room.title}</span>
          </button>
        ))
      }

      <ul class="mx-campus__fallback">
        {
          campusRooms.map((room) => (
            <li>
              {room.link ? (
                <a class="mx-link" href={room.link.href}>{room.title}</a>
              ) : (
                <span>{room.title}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mx-campus__mobile" data-mobile-controls>
    <div class="mx-campus__toolbar">
      <span class="mx-label">Deine kleine Roomtour</span>
      <button type="button" class="mx-campus__toggle" data-campus-toggle aria-pressed="false"><span data-toggle-label>Haus öffnen</span><span aria-hidden="true"> ↗</span></button>
    </div>
    <p class="mx-campus__tip">Raum antippen: Die Markierung zeigt dir, wo er liegt.</p>
    <div class="mx-campus__rooms" role="group" aria-label="Räume entdecken">
      {campusRooms.map((room) => (
        <button type="button" data-mobile-room={room.id} aria-expanded="false" aria-controls={`mx-campus-card-${room.id}`}><span class="mx-campus__room-name">{room.title}</span><span aria-hidden="true"> +</span></button>
      ))}
    </div>
  </div>

  <div class="mx-campus__cards">
    {
      campusRooms.map((room) => (
        <div class="mx-mapcard" id={`mx-campus-card-${room.id}`} data-card={room.id} data-accent={accentFor(room.link?.href)} role="region" aria-label={room.title} hidden>
          <button class="mx-mapcard__close" type="button" data-card-close aria-label="Karte schließen">
            <span aria-hidden="true">×</span>
          </button>
          <div class="mx-mapcard__media">
            {room.image ? (
              <Photo src={room.image} alt={room.alt ?? room.title} sizes="320px" widths={[320, 640]} />
            ) : (
              <CourtIllustration />
            )}
          </div>
          <h3 class="mx-h4">{room.title}</h3>
          <p>{room.text}</p>
          {room.link && (
            <a class="mx-link" href={room.link.href}>
              {room.link.label}
            </a>
          )}
          <p class="mx-mapcard__summary">{room.summary}</p>
        </div>
      ))
    }
  </div>

  <noscript><style>.mx-campus__loading { display: none; } .mx-campus__fallback { display: flex; }</style></noscript>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-campus]');
  if (root) {
    root.dataset.state = 'loading';
    const start = async () => {
      try {
        const { mountCampus } = await import('../scripts/campus/scene.js');
        const app = mountCampus(root);
        if (!app) {
          root.dataset.state = 'unsupported';
          return;
        }
        // Free the GPU right away when the page is really left (not on bfcache).
        window.addEventListener('pagehide', (event) => {
          if (!event.persisted) app.destroy();
        });
      } catch (error) {
        console.warn('Die 3D-Roomtour konnte nicht geladen werden.', error);
        root.dataset.state = 'unsupported';
      }
    };
    const near = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        near.disconnect();
        start();
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(root);
  }
</script>

<style>
  .mx-campus {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
    text-align: left;
    color: var(--ink);
  }

  .mx-campus__panel {
    position: relative;
    height: clamp(460px, 54vw, 700px);
  }

  .mx-campus__viewer {
    position: absolute;
    inset: 0;
  }

  .mx-campus__viewer :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: manipulation;
  }

  .mx-campus__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: var(--fs-small);
    color: var(--white);
  }
  .mx-campus[data-state="ready"] .mx-campus__loading,
  .mx-campus[data-state="unsupported"] .mx-campus__loading { display: none; }

  .mx-campus__fallback {
    display: none;
    position: absolute;
    inset: 0;
    flex-wrap: wrap;
    align-content: center;
    justify-content: center;
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-6);
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--fs-label);
  }
  .mx-campus__fallback,
  .mx-campus__fallback .mx-link { color: var(--white); }
  .mx-campus[data-state="unsupported"] .mx-campus__fallback { display: flex; }

  .mx-campus__stems {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .mx-campus__stems :global(line) {
    stroke: var(--ink);
    stroke-width: 1.5;
    opacity: 0.45;
  }

  /* ---------- "+" markers ---------- */
  .mx-hotspot {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    border-radius: 50%;
    border: 0;
    background: var(--white);
    color: var(--accent-strong);
    box-shadow: 0 0 0 6px var(--hotspot-halo), 0 2px 0 var(--ink);
    display: grid;
    place-items: center;
    font: 28px/1 var(--font-display);
    transition: translate var(--motion-fast) var(--ease-matrix);
  }
  .mx-hotspot[hidden] { display: none; }
  .mx-hotspot > span:first-child { transform: translateY(1px); }
  .mx-hotspot__label { display: none; }
  .mx-hotspot:hover { translate: 0 -3px; z-index: 3; }
  .mx-hotspot[aria-expanded="true"] { background: var(--ink); color: var(--white); z-index: 3; }

  /* Until the first room is opened, the markers softly ping in turn. */
  .mx-hotspot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid var(--white);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mx-campus:not(.is-explored) .mx-hotspot::after { animation: mx-campus-ping 2.8s ease-out infinite; }
    .mx-campus:not(.is-explored) .mx-hotspot:nth-of-type(2n)::after { animation-delay: 0.7s; }
    .mx-campus:not(.is-explored) .mx-hotspot:nth-of-type(3n)::after { animation-delay: 1.4s; }
    .mx-mapcard:not([hidden]) { animation: mx-campus-card-pop var(--motion-slow) var(--ease-matrix); }
  }

  @keyframes mx-campus-ping {
    0% { transform: scale(1); opacity: 0.8; }
    45%, 100% { transform: scale(1.75); opacity: 0; }
  }

  @keyframes mx-campus-card-pop {
    from { translate: 0 10px; rotate: -2deg; }
    to { translate: 0 0; rotate: 0deg; }
  }

  /* ---------- Room card ---------- */
  .mx-mapcard {
    position: absolute;
    z-index: 4;
    width: 320px;
    max-width: calc(100% - 32px);
    padding: 12px 12px 20px;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-press), var(--shadow-float);
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    pointer-events: none;
  }
  .mx-mapcard[hidden] { display: none; }
  .mx-mapcard[data-pinned="true"],
  .mx-mapcard:focus-within { pointer-events: auto; }
  .mx-mapcard[data-pinned="false"]:not([hidden]) { display: grid; grid-template-columns: 88px minmax(0, 1fr); column-gap: 12px; align-items: center; width: 300px; padding: 12px; }
  .mx-mapcard[data-pinned="false"] .mx-mapcard__media { grid-column: 1; grid-row: 1 / span 2; aspect-ratio: 1; }
  .mx-mapcard[data-pinned="false"] h3 { grid-column: 2; align-self: end; margin: 0; }
  .mx-mapcard[data-pinned="false"] > p:not(.mx-mapcard__summary) { display: none; }
  .mx-mapcard[data-pinned="false"] .mx-mapcard__summary { grid-column: 2; align-self: start; margin: 6px 0 0; }
  .mx-mapcard[data-pinned="false"] > a { display: none; }
  .mx-mapcard:not([data-pinned="true"]):not(:focus-within) .mx-mapcard__close { visibility: hidden; }
  .mx-mapcard[data-pinned="true"] .mx-mapcard__summary { display: none; }
  .mx-mapcard .mx-mapcard__summary { margin-top: 12px; color: var(--ink-muted); font-size: 12px; line-height: 1.4; }

  .mx-mapcard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    background: color-mix(in oklab, var(--accent) 22%, var(--white));
  }
  .mx-mapcard__media :global(picture) { position: absolute; inset: 0; }
  .mx-mapcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mx-mapcard__close {
    position: absolute;
    z-index: 1;
    top: 18px;
    right: 18px;
    width: 30px;
    height: 30px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 2px 0 var(--ink);
    font: 22px/1 var(--font-display);
  }
  .mx-mapcard__close span { transform: translateY(1px); }

  .mx-mapcard h3 { margin: 14px 8px 6px; color: var(--accent-strong); }
  .mx-mapcard p { margin: 0 8px; font-size: 15px; line-height: 22px; }
  .mx-mapcard a { margin: 12px 8px 0; display: inline-block; }

  .mx-campus__mobile { display: none; }

  @media (max-width: 600px) {
    .mx-campus__panel { height: clamp(250px, 70vw, 320px); margin-inline: calc(-1 * var(--page-margin)); }
    .mx-hotspot, .mx-campus__stems { display: none; }
    .mx-campus[data-state="ready"] .mx-campus__mobile { display: block; margin-top: var(--space-3); }
    .mx-campus__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; color: var(--white); }
    .mx-campus__toolbar .mx-label { font-size: 22px; }
    .mx-campus__toggle { flex-shrink: 0; border: 2px solid var(--ink); border-radius: 8px; padding: 8px 10px; background: var(--yellow-500); color: var(--ink); box-shadow: 2px 2px 0 var(--ink); font: 18px/1.2 var(--font-display); }
    .mx-campus__tip { margin: 14px 0 8px; color: var(--white); font-size: 12px; }
    .mx-campus__rooms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding: 3px 3px 10px; }
    .mx-campus__rooms button { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; min-height: 44px; padding: 9px 10px; border: 2px solid var(--ink); border-radius: 8px; background: var(--white); box-shadow: 2px 2px 0 var(--ink); font: 19px/1.1 var(--font-display); }
    .mx-campus__rooms button[aria-expanded="true"] { background: var(--ink); color: var(--white); }
    .mx-campus__rooms button:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .mx-campus__rooms button > span:last-child { flex-shrink: 0; font-size: 24px; }
    .mx-campus__room-name { min-width: 0; text-align: left; overflow-wrap: anywhere; hyphens: auto; }

    .mx-hotspot { width: 0; height: 0; margin: 0; background: transparent; box-shadow: none; transition: none; }
    .mx-hotspot[aria-expanded="true"] { display: block; pointer-events: none; background: transparent; box-shadow: none; }
    .mx-hotspot > span:first-child { display: none; }
    .mx-hotspot::after { display: none; }
    .mx-hotspot[aria-expanded="true"] .mx-hotspot__label { display: block; position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); width: max-content; max-width: 110px; padding: 3px 6px; border: 1px solid var(--ink); border-radius: 5px; background: var(--white); color: var(--ink); text-align: center; font: 13px/1.1 var(--font-display); }

    /* Keep the selected location and all room choices clear of the details. */
    .mx-mapcard {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      max-width: none;
      max-height: none;
      margin-top: var(--space-4);
      pointer-events: auto;
    }
    .mx-mapcard__media { aspect-ratio: 16 / 9; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-hotspot { transition: none; }
  }
</style>
