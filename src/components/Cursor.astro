---
/**
 * Animated MatriX hand cursor for mouse users. Over anything clickable the
 * hand pokes left and three tap lines draw in at the fingertip; holding the
 * button pushes the poke all the way. Touch devices and pages without JS keep
 * the static CSS cursors from global.css.
 *
 * Geometry matches the static cursor images: a 46×35 box with the hand at
 * (10, 8) and the fingertip hotspot at (10, 10), tilted 20° clockwise around
 * the fingertip so it points up-left like a system arrow.
 */
---

<div class="mx-cursor" aria-hidden="true" data-cursor hidden>
  <div class="mx-cursor__tilt">
    <div class="mx-cursor__hand">
      <img src="/graphics/cursors/hand-flat@2x.png" width="36" height="27" alt="" decoding="sync" />
    </div>
    <svg class="mx-cursor__taps" viewBox="0 0 46 35" width="46" height="35">
      <path d="M7 6 4 3" />
      <path d="M6 10H2" />
      <path d="M7 14 4 17" />
    </svg>
  </div>
  <svg class="mx-cursor__finder" viewBox="0 0 46 35" width="46" height="35">
    <path d="M-5 5v-7h7M18-2h7v7M25 15v7h-7M2 22h-7v-7" />
    <circle class="mx-cursor__rec" cx="20" cy="3" r="1.6" />
    <path class="mx-cursor__cross" d="M10 7v6M7 10h6" />
  </svg>
</div>

<!-- Inline (not bundled) so it runs during parsing, before the first paint
     of a newly loaded page — the hand is back in place without waiting for
     the first mouse move. -->
<script is:inline>
  (() => {
    const CLICKABLE = 'a[href], button:not(:disabled), [role="button"], summary, label[for], select';
    const TEXT = 'input:not([type="button"], [type="submit"], [type="reset"], [type="checkbox"], [type="radio"]), textarea, [contenteditable]';
    const HOTSPOT = 10;
    const STORE = 'mx-cursor';
    const FRESH_MS = 10000;

    const cursor = document.querySelector('[data-cursor]');
    const root = document.documentElement;
    if (!cursor || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      root.classList.remove('mx-has-cursor');
      return;
    }

    let x = 0;
    let y = 0;
    let frame = 0;

    // Keep the cursor above modal dialogs (the mobile menu) via the top layer.
    const usesTopLayer = 'showPopover' in cursor;
    const raise = () => {
      if (!usesTopLayer || !cursor.isConnected) return;
      if (cursor.matches(':popover-open')) cursor.hidePopover();
      cursor.showPopover();
    };
    if (usesTopLayer) cursor.setAttribute('popover', 'manual');
    cursor.hidden = false;
    raise();

    new MutationObserver(raise).observe(document.body, {
      subtree: true,
      attributes: true,
      attributeFilter: ['open'],
    });

    const render = () => {
      frame = 0;
      cursor.style.transform = `translate3d(${x - HOTSPOT}px, ${y - HOTSPOT}px, 0)`;
    };

    const show = (visible) => {
      cursor.classList.toggle('is-visible', visible);
      root.classList.toggle('mx-has-cursor', visible);
    };

    const update = (target) => {
      const overText = !!(target && target.closest(TEXT));
      // Easter eggs: playable stickers give the hand their own state (Play.astro).
      const play = target && target.closest('[data-play]');
      const mode = play && !overText ? play.getAttribute('data-play') : '';
      if (mode) cursor.dataset.mode = mode;
      else delete cursor.dataset.mode;
      const clickable = !!(target && target.closest(CLICKABLE)) || mode === 'spin';
      cursor.classList.toggle('is-link', !overText && clickable);
      show(!overText);
    };

    // Remember where the mouse was so the next page can draw the hand at once.
    const save = () => {
      try {
        sessionStorage.setItem(STORE, JSON.stringify({ x, y, t: Date.now() }));
      } catch {}
    };

    try {
      const last = JSON.parse(sessionStorage.getItem(STORE) || 'null');
      if (last && Date.now() - last.t < FRESH_MS) {
        x = last.x;
        y = last.y;
        render();
        update(document.elementFromPoint(x, y));
      } else {
        root.classList.remove('mx-has-cursor');
      }
    } catch {
      root.classList.remove('mx-has-cursor');
    }

    document.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch' || event.pointerType === 'pen') return show(false);
        x = event.clientX;
        y = event.clientY;
        if (!frame) frame = requestAnimationFrame(render);
        update(event.target instanceof Element ? event.target : null);
      },
      { passive: true },
    );

    // Scrolling moves new elements under a resting mouse.
    window.addEventListener(
      'scroll',
      () => {
        if (cursor.classList.contains('is-visible')) update(document.elementFromPoint(x, y));
      },
      { passive: true },
    );

    document.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') return;
      cursor.classList.add('is-down');
      save();
    });
    document.addEventListener('pointerup', () => cursor.classList.remove('is-down'));
    window.addEventListener('pagehide', save);
    // Back/forward cache: the page comes back as it was left, minus the press.
    window.addEventListener('pageshow', () => cursor.classList.remove('is-down'));
    // Hide only when the mouse really leaves the window. (Over the browser's
    // own scrollbar the system arrow always shows — that can't be styled.)
    document.addEventListener('mouseout', (event) => {
      if (!event.relatedTarget) show(false);
    });
  })();
</script>

<style>
  .mx-cursor {
    position: fixed;
    inset: 0 auto auto 0;
    z-index: 2147483647;
    width: 46px;
    height: 35px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
    pointer-events: none;
    visibility: hidden;
    will-change: transform;
    view-transition-name: mx-cursor;
  }
  .mx-cursor.is-visible { visibility: visible; }

  /* The real cursor is hidden only while the hand is drawn. */
  :global(html.mx-has-cursor),
  :global(html.mx-has-cursor *) {
    cursor: none !important;
  }
  :global(html.mx-has-cursor ::backdrop) { cursor: none !important; }

  .mx-cursor__tilt {
    position: absolute;
    inset: 0;
    transform: rotate(20deg);
    transform-origin: 10px 10px;
  }

  .mx-cursor__hand {
    position: absolute;
    left: 10px;
    top: 8px;
    width: 36px;
    transform-origin: 90% 70%;
    transition: transform var(--motion-fast) var(--ease-matrix);
  }
  .mx-cursor__hand img { width: 36px; height: auto; max-width: none; }

  .mx-cursor__taps {
    position: absolute;
    inset: 0;
    overflow: visible;
  }
  .mx-cursor__taps path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    /* Each line is drawn from the fingertip outwards. */
    stroke-dasharray: 5;
    stroke-dashoffset: 5;
  }

  /* ---------- Clickable: poke + tap lines ---------- */
  .mx-cursor.is-link .mx-cursor__hand { animation: mx-poke 0.7s var(--ease-matrix) infinite; }
  .mx-cursor.is-link .mx-cursor__taps path { animation: mx-tap 0.7s var(--ease-matrix) infinite; }
  .mx-cursor.is-link .mx-cursor__taps path:nth-child(2) { animation-delay: 0.03s; }
  .mx-cursor.is-link .mx-cursor__taps path:nth-child(3) { animation-delay: 0.06s; }

  @keyframes mx-poke {
    0%, 55%, 100% { transform: translateX(0) rotate(0); }
    22% { transform: translateX(-3px) rotate(-4deg); }
  }

  @keyframes mx-tap {
    0%, 12% { stroke-dashoffset: 5; }
    26%, 44% { stroke-dashoffset: 0; }
    60%, 100% { stroke-dashoffset: -5; }
  }

  /* ---------- Pressed: poke all the way in ---------- */
  .mx-cursor.is-down .mx-cursor__hand {
    animation: none;
    transform: translateX(-4px) rotate(-6deg);
  }
  .mx-cursor.is-link.is-down .mx-cursor__taps path {
    animation: none;
    stroke-dashoffset: 0;
  }

  /* ---------- Easter eggs over playable stickers ---------- */
  .mx-cursor__finder {
    position: absolute;
    inset: 0;
    overflow: visible;
    visibility: hidden;
  }
  .mx-cursor__finder path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mx-cursor__finder .mx-cursor__cross { stroke-width: 1.6; }
  .mx-cursor__rec { fill: var(--coral-600); }

  /* pet — the hand strokes the character */
  .mx-cursor[data-mode="pet"] .mx-cursor__hand { animation: mx-pet 0.7s ease-in-out infinite; }
  .mx-cursor[data-mode="pet"] .mx-cursor__taps path { animation: none; stroke-dashoffset: 5; }

  /* hot — the hand jerks back, heat lines flicker */
  .mx-cursor[data-mode="hot"] .mx-cursor__hand { animation: mx-hot 0.26s linear infinite; }
  .mx-cursor[data-mode="hot"] .mx-cursor__taps path {
    stroke: var(--orange-500);
    animation: mx-tap 0.35s linear infinite;
  }

  /* love — a gentle bob (hearts trail behind, see Play.astro) */
  .mx-cursor[data-mode="love"] .mx-cursor__hand { animation: mx-bob 0.9s ease-in-out infinite; }
  .mx-cursor[data-mode="love"] .mx-cursor__taps path { animation: none; stroke-dashoffset: 5; }

  /* snap — the hand becomes a viewfinder */
  .mx-cursor[data-mode="snap"] .mx-cursor__tilt { visibility: hidden; }
  .mx-cursor[data-mode="snap"] .mx-cursor__finder { visibility: visible; }
  .mx-cursor[data-mode="snap"] .mx-cursor__rec { animation: mx-rec 1s steps(1) infinite; }
  .mx-cursor[data-mode="snap"].is-down .mx-cursor__finder { scale: 0.85; transform-origin: 10px 10px; }

  @keyframes mx-pet {
    0%, 100% { transform: translateX(0) rotate(0); }
    50% { transform: translateX(5px) rotate(5deg); }
  }

  @keyframes mx-hot {
    0%, 100% { transform: translate(0, 0) rotate(0); }
    25% { transform: translate(1.5px, -1px) rotate(3deg); }
    75% { transform: translate(-1px, 1px) rotate(-2deg); }
  }

  @keyframes mx-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px) rotate(-3deg); }
  }

  @keyframes mx-rec {
    0% { fill: var(--coral-600); }
    50% { fill: transparent; }
  }

  /* Reduced motion: no loop — the variant simply shows its tap pose. */
  @media (prefers-reduced-motion: reduce) {
    .mx-cursor__hand { transition: none; }
    .mx-cursor.is-link .mx-cursor__hand {
      animation: none;
      transform: translateX(-3px) rotate(-4deg);
    }
    .mx-cursor.is-link .mx-cursor__taps path {
      animation: none;
      stroke-dashoffset: 0;
    }
    .mx-cursor[data-mode] .mx-cursor__hand,
    .mx-cursor[data-mode] .mx-cursor__taps path,
    .mx-cursor[data-mode] .mx-cursor__rec { animation: none; }
  }
</style>
