---
/**
 * Shared layout for a room's detail page: photo hero, short intro, alternating
 * sections and the closing invitation. A section without photos gets the
 * room's little game through the `gag` slot; `aside` sits next to the intro.
 */
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHero from './PhotoHero.astro';
import FeatureRow from './FeatureRow.astro';
import CtaBlock from './CtaBlock.astro';
import type { Accent } from '../data/site';
import type { Peeker } from './Footer.astro';
import type { RoomSection } from '../data/room-pages';
import { roomSectionText } from '../data/room-pages';

interface Props {
  title: string;
  description: string;
  accent: Accent;
  peeker?: Peeker;
  hero: ImageMetadata;
  heroAlt: string;
  heading: string;
  lead: string;
  sections: RoomSection[];
}

const { title, description, accent, peeker, hero, heroAlt, heading, lead, sections } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<BaseLayout title={title} description={description} accent={accent} current="raeume" peeker={peeker}>
  <PhotoHero image={hero} alt={heroAlt} title={title} />

  <section class="mx-section room-intro">
    <div class:list={['mx-container', hasAside && 'room-intro__grid']}>
      <div>
        <nav class="room-breadcrumb" aria-label="Brotkrumennavigation"><a href="/raeume/">Unsere Räume</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
        <h2 class="mx-h1">{heading}</h2>
        <p class="mx-lead">{lead}</p>
      </div>
      <slot name="aside" />
    </div>
  </section>

  <section class="mx-section room-sections">
    <div class="mx-container">
      {sections.map((section, i) => section.photos ? (
        <FeatureRow id={section.slug} title={section.title} text={section.text ?? roomSectionText} photos={section.photos} alt={section.alt} flip={i % 2 === 0} offset={i % 2 === 0 ? 'tr' : 'br'} />
      ) : (
        <FeatureRow id={section.slug} title={section.title} text={section.text ?? roomSectionText} flip={i % 2 === 0}>
          <div slot="media" class="room-gag"><slot name="gag" /></div>
        </FeatureRow>
      ))}
    </div>
  </section>

  <CtaBlock title="Du hast Bock oder eine eigene Idee?" lead="Wir sind immer offen für neue Ideen und coole Sachen. Schreib uns oder komm einfach vorbei." label="Lass uns loslegen!" href="/mitmachen/" />
</BaseLayout>

<style>
  .room-intro { padding-bottom: var(--space-9); }
  .room-intro__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 380px); gap: var(--space-8); align-items: center; }
  .room-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 13px; margin-bottom: 24px; color: var(--ink-muted); }
  .room-breadcrumb a { color: var(--ink); text-underline-offset: 3px; }
  .room-intro .mx-lead { max-width: 560px; margin-top: var(--space-5); }
  .room-sections { padding-top: 0; }
  .room-sections :global(.mx-feature) { scroll-margin-top: calc(var(--nav-height) + 40px); }
  .room-gag { display: flex; justify-content: center; width: 100%; }

  @media (max-width: 860px) {
    .room-intro__grid { grid-template-columns: 1fr; gap: 32px; }
    .room-intro__grid > :global(:last-child) { width: 100%; max-width: 420px; justify-self: center; }
  }
  @media (max-width: 600px) {
    .room-intro .mx-h1 { font-size: 44px; }
  }
</style>
