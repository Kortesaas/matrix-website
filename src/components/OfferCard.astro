---
/** One offer: square photo on an offset block in the card's own colour, display title, meta line. */
import PhotoFrame, { type Offset } from './PhotoFrame.astro';
import type { Offer } from '../data/offers';

interface Props {
  offer: Offer;
  offset?: Offset;
}

const { offer, offset = 'bl' } = Astro.props;
const Tag = offer.href ? 'a' : 'div';
---

<Tag
  class:list={['mx-offer', offer.href && 'mx-offer--link']}
  id={offer.slug}
  href={offer.href}
  style={`--frame: var(--${offer.frame}-500); --frame-strong: var(--${offer.frame}-600)`}
>
  <PhotoFrame
    src={offer.image}
    interactive={!offer.href}
    alt=""
    ratio="1"
    offset={offset}
    sizes="(max-width: 600px) 45vw, (max-width: 1024px) 45vw, 400px"
  />
  <div class="mx-offer__title">{offer.title}</div>
  {offer.meta && <div class="mx-offer__meta">{offer.meta}</div>}
</Tag>

<style>
  .mx-offer {
    display: block;
    text-decoration: none;
    color: inherit;
    scroll-margin-top: var(--space-11);
  }

  .mx-offer :global(.mx-photo) {
    transition: transform var(--motion-slow) var(--ease-matrix);
  }

  .mx-offer--link:hover :global(.mx-photo) {
    transform: rotate(var(--tilt-hover)) translateY(var(--lift-hover));
  }

  .mx-offer__title {
    margin-top: var(--space-5);
    text-align: center;
    color: var(--frame-strong, var(--accent-strong));
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1.05;
  }

  .mx-offer__meta {
    margin-top: 4px;
    text-align: center;
    font-size: 15px;
    line-height: 22px;
    color: var(--ink-muted);
  }

  @media (max-width: 600px) {
    .mx-offer__title { font-size: 22px; margin-top: var(--space-4); }
    .mx-offer__meta { font-size: 13px; line-height: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mx-offer :global(.mx-photo) { transition: none; }
  }
</style>
