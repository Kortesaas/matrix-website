---
/**
 * "Events" and "Jede Woche" as two white panels with the hard ink drop.
 * The rows come from the live calendar (see src/scripts/calendar-data.ts).
 */
const columns = [
  { key: 'events', title: 'Events', empty: 'Gerade ist kein Event eingetragen. Schau bald wieder vorbei!' },
  { key: 'weekly', title: 'Jede Woche', empty: '' },
];
---

<div class="mx-events" data-event-list>
  {
    columns.map((col) => (
      <section class="mx-events__col" data-column={col.key} data-empty={col.empty}>
        <h3 class="mx-h4">{col.title}</h3>
        <ul class="mx-events__list" aria-busy="true">
          <li class="mx-events__item mx-events__item--note">Termine werden geladen …</li>
        </ul>
      </section>
    ))
  }
  <template data-event-row>
    <li class="mx-events__item">
      <span class="mx-events__date"></span>
      <span class="mx-events__name"><span data-name></span><span class="mx-events__sub"></span></span>
    </li>
  </template>
  <template data-event-note>
    <li class="mx-events__item mx-events__item--note"></li>
  </template>
</div>

<script>
  import { eventColumns } from '../data/events';
  import { loadEvents } from '../scripts/calendar-data';

  for (const root of document.querySelectorAll<HTMLElement>('[data-event-list]')) {
    const row = root.querySelector<HTMLTemplateElement>('[data-event-row]')!;
    const note = root.querySelector<HTMLTemplateElement>('[data-event-note]')!;
    const fill = (list: HTMLElement, items: { date: string; name: string; sub?: string }[], message: string) => {
      list.replaceChildren();
      list.removeAttribute('aria-busy');
      if (!items.length) {
        const li = note.content.firstElementChild!.cloneNode(true) as HTMLElement;
        li.textContent = message;
        list.append(li);
        return;
      }
      for (const item of items) {
        const li = row.content.firstElementChild!.cloneNode(true) as HTMLElement;
        li.querySelector('.mx-events__date')!.textContent = item.date;
        li.querySelector('[data-name]')!.textContent = item.name;
        const sub = li.querySelector<HTMLElement>('.mx-events__sub')!;
        if (item.sub) sub.textContent = item.sub;
        else sub.remove();
        list.append(li);
      }
    };

    loadEvents()
      .then((events) => {
        const [special, weekly] = eventColumns(events);
        for (const [key, col] of [['events', special], ['weekly', weekly]] as const) {
          const section = root.querySelector<HTMLElement>(`[data-column="${key}"]`)!;
          // Without weekly dates in the calendar, that panel steps aside.
          if (key === 'weekly' && !col.items.length) {
            section.hidden = true;
            root.classList.add('mx-events--single');
            continue;
          }
          fill(section.querySelector('ul')!, col.items, section.dataset.empty ?? '');
        }
      })
      .catch(() => {
        for (const list of root.querySelectorAll<HTMLElement>('.mx-events__list')) {
          fill(list, [], 'Die Termine sind gerade nicht erreichbar. Versuch es später noch einmal.');
        }
      });
  }
</script>

<style>
  .mx-events {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    text-align: left;
  }

  .mx-events__col {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-press);
    color: var(--ink);
  }
  .mx-events__col h3 { margin-bottom: var(--space-4); }

  .mx-events__list { list-style: none; margin: 0; padding: 0; }

  .mx-events__item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: 14px 0;
    border-top: 2px dashed var(--line);
  }
  .mx-events__item:first-child { border-top: 0; }
  .mx-events__item--note { display: block; color: var(--ink-muted); font-size: var(--fs-small); line-height: var(--lh-small); }
  .mx-events--single { grid-template-columns: 1fr; max-width: 640px; margin: 0 auto; }
  .mx-events__col[hidden] { display: none; }

  .mx-events__date {
    display: inline-block;
    transition: translate var(--motion-fast) var(--ease-matrix), rotate var(--motion-fast) var(--ease-matrix);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    line-height: 1;
    color: var(--accent-strong);
  }

  .mx-events__item:hover .mx-events__date { translate: 0 -2px; rotate: -5deg; }

  .mx-events__name { font-weight: 600; }

  .mx-events__sub {
    display: block;
    font-weight: 400;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .mx-events { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .mx-events__col { padding: var(--space-5); }
    .mx-events__item { grid-template-columns: 64px 1fr; }
  }
</style>
