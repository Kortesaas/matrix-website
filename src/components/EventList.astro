---
/** "Events" and "Jede Woche" as two white panels with the hard ink drop. */
import type { EventColumn } from '../data/events';

interface Props {
  columns: EventColumn[];
}

const { columns } = Astro.props;
---

<div class="mx-events">
  {
    columns.map((col) => (
      <section class="mx-events__col">
        <h3 class="mx-h4">{col.title}</h3>
        <ul class="mx-events__list">
          {col.items.map((item) => (
            <li class="mx-events__item">
              <span class="mx-events__date">{item.date}</span>
              <span class="mx-events__name">
                {item.name}
                {item.sub && <span class="mx-events__sub">{item.sub}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .mx-events {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    text-align: left;
  }

  .mx-events__col {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-press);
    color: var(--ink);
  }
  .mx-events__col h3 { margin-bottom: var(--space-4); }

  .mx-events__list { list-style: none; margin: 0; padding: 0; }

  .mx-events__item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding: 14px 0;
    border-top: 2px dashed var(--line);
  }
  .mx-events__item:first-child { border-top: 0; }

  .mx-events__date {
    display: inline-block;
    transition: translate var(--motion-fast) var(--ease-matrix), rotate var(--motion-fast) var(--ease-matrix);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    line-height: 1;
    color: var(--accent-strong);
  }

  .mx-events__item:hover .mx-events__date { translate: 0 -2px; rotate: -5deg; }

  .mx-events__name { font-weight: 600; }

  .mx-events__sub {
    display: block;
    font-weight: 400;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .mx-events { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .mx-events__col { padding: var(--space-5); }
    .mx-events__item { grid-template-columns: 64px 1fr; }
  }
</style>
